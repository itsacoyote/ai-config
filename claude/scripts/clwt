#!/usr/bin/env bash
# clwt — manage this repository's git worktrees and launch Claude Code inside them.
#
# The point of the tool: `claude` has no "start in directory" flag, it inherits its
# working directory from whatever launched it. So every launching subcommand cd's to
# the target and exec's `claude` there. That is what makes the session's cwd correct
# by construction, and `git -C` unnecessary.
#
# Because of that, the launching subcommands can only be run by the developer from a
# shell — Claude cannot relaunch itself into a new directory.

set -euo pipefail

PROGRAM=${0##*/}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 2
}

note() { printf '%s: %s\n' "$PROGRAM" "$*"; }
warn() { printf '%s: warning: %s\n' "$PROGRAM" "$*" >&2; }

# copy_worktree_includes can bail mid-loop; this is how its scratch file gets
# cleaned up regardless of which exit path is taken.
CLWT_LIST_FILE=''
CLWT_PR_FETCH_WORKTREE=''
cleanup_on_exit() {
  rm -f "${CLWT_LIST_FILE:-}"
  if [[ -n ${CLWT_PR_FETCH_WORKTREE:-} ]]; then
    git worktree remove --force "$CLWT_PR_FETCH_WORKTREE" >/dev/null 2>&1 || true
    rmdir "$CLWT_PR_FETCH_WORKTREE" >/dev/null 2>&1 || true
  fi
}
trap cleanup_on_exit EXIT

usage() {
  cat <<'EOF'
Usage:
  clwt [list]                       list this repository's managed worktrees
  clwt new <branch> [-- <args>]     branch from the origin default, then launch
  clwt branch <branch> [-- <args>]  check out an existing branch, then launch
  clwt open <branch> [-- <args>]    launch in an existing managed worktree
  clwt pr <n> [--force] [-- <args>]  check out a pull request, then launch
  clwt root [-- <args>]             launch in the primary checkout
  clwt remove <branch> [--delete-branch]
  clwt prune [--yes]                sweep worktrees whose branch has merged
  clwt install                      symlink clwt onto your PATH
  clwt help

Commands:
  new       Create an explicitly named branch from the origin default and launch.
  branch    Check out or reuse an existing local/remote branch and launch.
  open      Launch in an existing managed worktree by branch name.
  pr        Check a pull request out into a managed worktree and launch.
  root      Launch in the primary (non-worktree) checkout.
  list      List this repository's managed worktrees.
  remove    Remove a clean managed worktree; keep its branch by default.
  prune     Remove managed worktrees whose branch has an already-merged PR.
  install   Symlink this script to ~/.local/bin/clwt.
  help      Show this usage.

Managed worktrees live in:
  ~/github/.worktrees/<owner>/<repo>/<branch-with-slashes-as-dashes>/

`--yolo` on a launching subcommand adds --dangerously-skip-permissions, which
bypasses every permission check for that session.

`--force` on `clwt pr` passes --force to `gh pr checkout`, resetting a leftover
local branch to the pull request head. An existing managed PR worktree is
refreshed only after clwt verifies its PR identity and its clean local state;
`--force` does not bypass those reuse guards.
Without the flag, `clwt pr` resets a leftover branch on its own only when the
branch is provably contained in `origin/<branch>` (no local-only commits);
otherwise the checkout runs plain, and if it then fails, the error names this
flag.

Every launching subcommand passes --name to claude, naming the session: `pr <n>` becomes
`PR-<n>`; `new`/`branch`/`open` use the branch with slashes as dashes; `root` uses the
primary checkout's current branch, also with slashes as dashes, or no name on a
detached HEAD. A developer's own `--name`/`-n` after `--` overrides it, since claude
takes the last value it sees.

Arguments after `--` are passed through to `claude`.
EOF
}

# --------------------------------------------------------------- foundations

# Physically resolves a path that need not exist yet: walk up to the deepest
# existing ancestor, resolve that, re-append the missing tail.
#
# Resolving only $HOME is not enough. `git worktree list` reports fully resolved
# paths, so if ~/github or ~/github/.worktrees is itself a symlink — relocating
# worktrees to a bigger volume is an ordinary thing to do — every containment
# check compares a resolved path against a partly-unresolved prefix, and clwt
# disowns the worktrees it just created.
resolve_path() {
  local path=$1 tail='' base
  while [[ ! -d $path && $path == */* ]]; do
    tail="${path##*/}${tail:+/$tail}"
    path=${path%/*}
    [[ -n $path ]] || path=/
  done
  base=$(cd -P "$path" 2>/dev/null && pwd -P) || return 1
  # When the walk reaches the filesystem root, `$base/` would double the
  # separator, and a `//prefix` managed root fails its own containment check —
  # the disown-your-own-worktree bug wearing a different hat.
  [[ $base != / ]] || base=''
  if [[ -n $tail ]]; then
    printf '%s/%s\n' "$base" "$tail"
  else
    printf '%s\n' "${base:-/}"
  fi
}

# Resolves, once, the four values every other subcommand builds on:
#   owner, repo         — from the origin remote
#   primary             — the primary (non-worktree) checkout
#   managed_root        — ~/github/.worktrees/<owner>/<repo>
#
# `primary` deserves a note. It is NOT `git rev-parse --show-toplevel`, which
# returns the *worktree* when clwt runs inside one — the common case here. Nor is
# it `--git-common-dir`, which returns the `.git` directory itself. It is the
# checkout containing that git dir, which is where .worktreeinclude lives, where
# the copy sources from, and what CLWT_REPO_ROOT must point at so a tracker can
# find its one central database.
require_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die 'run clwt from inside a git repository'

  local remote_url
  remote_url=$(git remote get-url origin 2>/dev/null) ||
    die 'repository has no origin remote'

  parse_remote_identity "$remote_url"

  local common_dir
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
    die 'cannot resolve the git common directory'
  primary=$(cd "$common_dir/.." 2>/dev/null && pwd -P) ||
    die "cannot resolve the primary checkout from: $common_dir"

  # Fully resolved, because every path this is later compared against is `pwd -P`'d.
  # Against an unresolved prefix clwt would create a worktree and then immediately
  # disown it: `list` marks it unmanaged, `open` and `remove` refuse it, and
  # `branch` reports it as checked out somewhere clwt does not manage — its own
  # worktree.
  managed_root=$(resolve_path "$HOME/github/.worktrees/$owner/$repo") ||
    die "cannot resolve the managed worktree root under: $HOME"
}

# Splits owner/repo out of any remote URL shape we care about, in pure shell:
#   git@host:owner/repo.git      https://host/owner/repo.git
#   ssh://git@host/owner/repo    /local/path/owner/repo.git
# In every one of those the last two path segments are owner and repo, so strip
# the .git suffix and take them from the end.
parse_remote_identity() {
  local url=$1 rest
  url=${url%.git}
  url=${url%/}

  repo=${url##*/}
  rest=${url%/*}
  owner=${rest##*/}
  owner=${owner##*:} # git@host:owner -> owner

  valid_identity_part "$owner" || die "cannot derive owner from origin: $1"
  valid_identity_part "$repo" || die "cannot derive repository from origin: $1"
}

valid_identity_part() {
  case $1 in
    '' | . | .. | *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

# --------------------------------------------------------------- launching

# Splits a launching subcommand's arguments into three parts:
#   LAUNCH_POSITIONAL — the subcommand's own operands (a branch, a PR number)
#   LAUNCH_YOLO       — 1 when --yolo was given
#   LAUNCH_ARGS       — everything after `--`, handed to claude untouched
#
# Everything before `--` belongs to clwt. An unrecognized clwt-side flag is an
# error rather than being forwarded, so a typo like `--yolol` fails loudly
# instead of silently reaching claude as an unknown argument.
parse_launch_args() {
  LAUNCH_YOLO=0
  LAUNCH_ARGS=()
  LAUNCH_POSITIONAL=()
  LAUNCH_NAME=''
  while [[ $# -gt 0 ]]; do
    case $1 in
      --)
        shift
        LAUNCH_ARGS=("$@")
        return 0
        ;;
      --yolo)
        LAUNCH_YOLO=1
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*)
        die "unknown option: $1 (run 'clwt help')"
        ;;
      *)
        LAUNCH_POSITIONAL+=("$1")
        ;;
    esac
    shift
  done
}

# The whole point of the tool. `claude` has no "start in directory" flag — it
# inherits its working directory from whoever launched it. So: cd into the
# target, then exec. The session's cwd is then correct by construction, which is
# what makes `git -C` unnecessary rather than merely discouraged.
#
# CLWT_REPO_ROOT rides along so any issue tracker in that session can find the
# one central database in the primary checkout. `bd` resolves it through the git
# common dir on its own; this is the tool-agnostic form of the same guarantee.
launch() {
  local target=$1
  local -a argv=()

  command -v claude >/dev/null 2>&1 || die 'claude not found on PATH'

  # Placed first so a developer's own `-- --name X` wins by position: claude
  # takes the last `--name` it sees, and LAUNCH_ARGS is appended after this.
  if [[ -n ${LAUNCH_NAME-} ]]; then
    argv+=(--name "$LAUNCH_NAME")
  fi
  if ((LAUNCH_YOLO)); then
    argv+=(--dangerously-skip-permissions)
  fi
  if ((${#LAUNCH_ARGS[@]})); then
    argv+=("${LAUNCH_ARGS[@]}")
  fi

  cd -P "$target" || die "cannot enter directory: $target"
  export CLWT_REPO_ROOT="$primary"

  note "launching claude in $target"
  if ((${#argv[@]})); then
    exec claude "${argv[@]}"
  fi
  exec claude
}

# ------------------------------------------------------------------- commands

validate_branch() {
  git check-ref-format --branch "$1" >/dev/null 2>&1 || die "invalid branch name: $1"
}

# Path of the worktree holding <branch>, if any. Prints nothing and returns 1
# when the branch is not checked out anywhere.
branch_worktree() {
  local wanted=$1 line path=''
  while IFS= read -r line; do
    case $line in
      'worktree '*)
        path=${line#worktree }
        ;;
      "branch refs/heads/$wanted")
        printf '%s\n' "$path"
        return 0
        ;;
    esac
  done < <(git worktree list --porcelain)
  return 1
}

# True iff <branch>'s local tip is provably contained in (equal to, or an
# ancestor of) refs/remotes/origin/<branch> AT THIS MOMENT — i.e. resetting the
# local branch to that tip would discard nothing. Fully-qualified refs only:
# head_ref is fork-controlled input, and an unqualified name could resolve to a
# tag or some other ref outside refs/heads / refs/remotes/origin entirely.
#
# Every check sits in its own `if`, never chained straight into merge-base:
# the script runs set -euo pipefail, and the ref this guards against missing —
# a branch clwt has never fetched — is the COMMON case here, not a corner one.
# The existence guard doubles as what keeps git's own "Not a valid object
# name" fatal off stderr on that common path, by never handing merge-base a
# ref that isn't there.
branch_contained_in_origin() {
  local branch=$1
  if ! git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    return 1
  fi
  # Fail closed: an ancestor match returns 0 (safe). Anything else — not an
  # ancestor (exit 1) or a broken repository state (exit >1) — returns 1
  # (not safe). A merge-base error must never read as "safe to reset".
  if git merge-base --is-ancestor "refs/heads/$branch" "refs/remotes/origin/$branch"; then
    return 0
  fi
  return 1
}

# Refuses anything clwt did not put where it expects. The symlink check comes
# first and is not redundant: without it, a symlink sitting inside the managed
# root could point anywhere, and the containment check below — which compares the
# *resolved* path — would be satisfied by a directory clwt never created.
require_managed_worktree() {
  local path=$1 physical
  [[ ! -L $path ]] || die "managed worktree path must not be a symlink: $path"
  physical=$(cd -P "$path" 2>/dev/null && pwd -P) ||
    die "cannot resolve worktree directory: $path"
  case $physical in
    "$managed_root"/*) ;;
    *) die "worktree is not under the managed root, so clwt does not manage it: $path" ;;
  esac
}

# Prefix assignment, never `export`: export would survive `exec claude` and
# land these options on every later push in that session. Base follows git's
# own ssh precedence; options are appended, so a custom command must accept OpenSSH -o.
remote_git() {
  local base
  if [[ -n ${GIT_SSH_COMMAND:-} ]]; then
    base=$GIT_SSH_COMMAND
  elif base=$(git config --get core.sshCommand 2>/dev/null); then
    :
  elif [[ -n ${GIT_SSH:-} ]]; then
    base=$(printf '%q' "$GIT_SSH")
  else
    base=ssh
  fi
  GIT_SSH_COMMAND="$base -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2" \
    git "$@"
}

# Asks the remote what its default branch is *now*. Deliberately not
# origin/HEAD, which is cached at clone time and goes stale the moment the
# repository's default branch changes — branching from a stale default is a
# quiet way to build on the wrong base.
default_remote_branch() {
  local ref
  if ! ref=$(remote_git ls-remote --symref origin HEAD |
    sed -n 's|^ref: refs/heads/\([^[:space:]]*\).*|\1|p' | head -1); then
    die 'cannot determine the current origin default branch'
  fi
  [[ -n $ref ]] || die 'cannot determine the current origin default branch'
  printf '%s\n' "$ref"
}

worktree_name_for_branch() {
  printf '%s\n' "${1//\//-}"
}

# The branch name has already passed check-ref-format, but it is about to become
# a directory name, so it gets a second, narrower check against the character set
# actually safe in a path segment.
validate_worktree_name() {
  case $1 in
    '' | . | .. | *..* | */* | *[!A-Za-z0-9._-]*)
      die "branch name does not produce a safe directory name: $1"
      ;;
  esac
}

registered_at() {
  local wanted=$1 line
  while IFS= read -r line; do
    if [[ $line == "worktree $wanted" ]]; then
      return 0
    fi
  done < <(git worktree list --porcelain)
  return 1
}

# A stale directory squatting on the target path makes `git worktree add` fail
# with a message about the path being unusable, which sends you looking in the
# wrong place. Catch it here and say what is actually wrong.
ensure_available_path() {
  local path=$1
  [[ ! -L $path ]] || die "target path must not be a symlink: $path"
  if [[ -e $path ]]; then
    registered_at "$path" ||
      die "target path exists but is not a registered worktree: $path"
  fi
}

# Copies the untracked files a fresh worktree needs to actually run the project —
# .env and friends — matching Claude Code's own .worktreeinclude behavior.
#
# Two things here are load-bearing:
#
# 1. Both the pattern file and the copy source come from the PRIMARY checkout.
#    `--exclude-from` resolves relative to the current directory, and clwt is
#    routinely run from inside a worktree, where neither would be found.
#
# 2. .beads/ is refused unconditionally, even when the patterns match it.
#    `git ls-files --others --ignored --exclude-from` does return gitignored
#    paths, so a `.beads/` entry here would be copied — giving the worktree its
#    own forked issue database whose writes diverge and are lost. That is exactly
#    the regression PR #48 fixed by removing the pattern; this refuses to
#    reintroduce it no matter what the pattern file says. Worktrees share the
#    primary checkout's single database through the git common dir.
# Removes a worktree that was created but could not be finished, so a retry does
# not trip over a path that exists and holds nothing useful — and, worse, so the
# next `clwt branch <same>` does not silently *reuse* a worktree that is missing
# the .env this function exists to provide.
abandon_worktree() {
  git worktree remove --force "$1" 2>/dev/null || true
}

copy_worktree_includes() {
  local target=$1
  local pattern_file="$primary/.worktreeinclude"
  [[ -f $pattern_file ]] || return 0

  # The list goes through a temp file rather than a variable: NUL-delimited output
  # cannot round-trip through $( ), which strips null bytes, and NUL-delimiting is
  # what keeps filenames containing spaces or newlines intact. A file also lets us
  # check git's exit status, so a failure is not read as "nothing matched".
  # Every failure below RETURNS rather than dies. Being called as `copy … || {…}`
  # disables errexit for this whole body, so each fallible step is checked by hand;
  # and a `die` here would exit clwt outright, so the caller's cleanup handler
  # would never run.
  # Templated, not bare: BSD/macOS `mktemp` requires a template or -t, so a bare
  # call is a usage error there — which would break every worktree-creating
  # command on macOS in any repo that has a .worktreeinclude. Same reason this
  # script hand-rolls symlink resolution instead of using GNU `readlink -f`.
  local list_file
  list_file=$(mktemp "${TMPDIR:-/tmp}/clwt.XXXXXX") || {
    warn 'cannot create a temporary file'
    return 1
  }
  CLWT_LIST_FILE=$list_file

  if ! (cd "$primary" &&
    git ls-files --others --ignored --exclude-from="$pattern_file" -z) >"$list_file"; then
    warn 'cannot list .worktreeinclude matches'
    return 1
  fi

  local resolved_target
  resolved_target=$(cd -P "$target" 2>/dev/null && pwd -P) || {
    warn "cannot resolve the worktree directory: $target"
    return 1
  }

  local rel src dst dst_dir resolved_dir copied=0 refused_beads=0
  while IFS= read -r -d '' rel; do
    case $rel in
      .beads | .beads/*)
        refused_beads=1
        continue
        ;;
    esac

    # Assertion, not a defense against a known vector: `git ls-files` emits
    # normalized repo-relative paths, so neither case should ever fire. It is
    # here because $rel is about to become a path we write to, and an invariant
    # that cheap is worth stating out loud rather than assuming.
    case $rel in
      /* | *..*)
        warn "refusing to copy a path that escapes the worktree: $rel"
        return 1
        ;;
    esac

    src="$primary/$rel"
    [[ -f $src ]] || continue
    dst="$target/$rel"

    # The destination is inside a tree whose *contents* came from a branch, which
    # on a fork PR means from someone else. A hostile branch can commit the
    # matched path as a tracked symlink pointing anywhere — git materializes it,
    # and `cp` then writes THROUGH it, straight out of the managed root. (cp's
    # -P/--no-dereference does not help; those govern the source.) Verified
    # writing to ~/.bashrc this way before the guard existed.
    if [[ -L $dst ]]; then
      warn "refusing to copy onto a symlink inside the worktree: $rel"
      return 1
    fi

    # A directory at the destination is the third shape, and it slips past both
    # the symlink check above and the parent-containment check below: given an
    # existing directory, `cp` copies *into* it as $dst/$(basename $src) — and
    # src and dst share a basename here, so a branch that commits `.env/` as a
    # directory holding a symlink named `.env` lands the write on that symlink.
    # Verified escaping to an arbitrary absolute path. Git can only materialise
    # regular files, symlinks, directories, and gitlinks (directories too), so
    # "nonexistent or a regular file" is the complete allowlist. Order matters:
    # -L must be tested first, because -f follows symlinks. `cp -pT` would also
    # fix it but -T is GNU-only, which the mktemp comment above exists to avoid.
    if [[ -e $dst && ! -f $dst ]]; then
      warn "refusing to copy onto a non-regular destination inside the worktree: $rel"
      return 1
    fi

    # Validate the parent BEFORE creating it. `mkdir -p` follows a committed
    # symlink at an intermediate component and creates the missing tail on the far
    # side, so checking afterwards still hands a hostile branch an
    # arbitrary-empty-directory primitive anywhere the developer can write.
    # resolve_path exists precisely to resolve a path that need not exist yet.
    dst_dir=${dst%/*}
    resolved_dir=$(resolve_path "$dst_dir") || {
      warn "cannot resolve the destination directory for $rel"
      return 1
    }
    case "$resolved_dir/" in
      "$resolved_target"/*) ;;
      *)
        warn "refusing to copy $rel — its destination resolves outside the worktree"
        return 1
        ;;
    esac

    mkdir -p "$dst_dir" || {
      warn "cannot create the directory for $rel"
      return 1
    }

    # Re-check after creating: an ancestor could have been created earlier in this
    # same loop, and the pre-check only saw the state before that.
    resolved_dir=$(cd -P "$dst_dir" 2>/dev/null && pwd -P) || {
      warn "cannot resolve the destination directory for $rel"
      return 1
    }
    case "$resolved_dir/" in
      "$resolved_target"/*) ;;
      *)
        warn "refusing to copy $rel — its destination resolves outside the worktree"
        return 1
        ;;
    esac

    cp -p "$src" "$dst" || {
      warn "cannot copy $rel into the worktree"
      return 1
    }
    copied=$((copied + 1))
  done <"$list_file"
  rm -f "$list_file"
  CLWT_LIST_FILE=''

  if ((refused_beads)); then
    warn "refusing to copy .beads/ — worktrees share the primary checkout's single issue database, and copying it forks them (see PR #48)"
  fi
  # Reported unconditionally: "copied 0" and a silent return would otherwise be
  # indistinguishable from the copy never having run.
  note "copied $copied file(s) matching .worktreeinclude"
}

# Applies the location guards shared by generic reuse and pull-request refresh.
# It deliberately does not launch or mutate anything: callers still have work
# to do after the target has been proven to be one clwt owns.
require_reusable_worktree() {
  local branch=$1 existing=$2
  if [[ $existing == "$primary" ]]; then
    die "$branch is checked out in the primary checkout ($primary); use 'clwt root' to work there"
  fi

  case $existing in
    "$managed_root"/*) ;;
    *) die "$branch is checked out at $existing, which clwt does not manage" ;;
  esac

  require_managed_worktree "$existing"
}

# Git allows a branch in exactly one worktree, so "it is already checked out" has
# three quite different meanings and three different right answers. Git's own
# message names none of them usefully, which leaves you hunting for where the
# branch actually is.
reuse_or_refuse() {
  local branch=$1 existing=$2 force=${3:-0}

  require_reusable_worktree "$branch" "$existing"
  # --force resets a branch clwt is about to check out fresh; once it is already
  # sitting in a managed worktree there is nothing to reset, so say so rather
  # than silently swallowing the flag.
  if ((force)); then
    note "not resetting $branch — it is already checked out at $existing"
  fi
  note "reusing existing worktree for $branch"
  launch "$existing"
}

# "Dirty" deliberately means `--untracked-files=all` WITHOUT `--ignored`, and
# neither obvious alternative works:
#
#   plain --porcelain     a worktree holding a .worktreeinclude-copied .env reads
#                         as clean (the project's .gitignore covers it), so
#                         removal would silently destroy it
#   ... --ignored         every worktree clwt creates reads as dirty, so removal
#                         would always refuse
#
# So: genuine uncommitted or untracked work blocks removal, and ignored files do
# not — but since `git worktree remove` deletes them without comment, they get
# named first. The report is the only thing standing between you and a lost .env.
# Both capture git's exit status explicitly. `set -e` does not help: errexit is
# disabled inside command substitution `$( )`, which is exactly why `rc=$?` is
# reachable here at all. Without the check, a git failure — index lock
# contention, a partially-pruned gitdir, a permission problem — yields empty
# output, which reads as "clean" and as "nothing will be destroyed". Both
# mistakes delete things.
#
# Note for future callers: these must be invoked from a command-substitution or
# an `if` condition. A process substitution `< <(...)` would NOT work — unlike
# `$( )`, it inherits errexit, so the assignment aborts the subshell before the
# status check runs, and a `die` there would only exit the subshell while the
# parent carried on deleting. That was a real bug here, not a hypothetical.
worktree_is_dirty() {
  local path=$1 action=${2:-remove} out rc
  out=$(cd "$path" && git status --porcelain --untracked-files=all)
  rc=$?
  ((rc == 0)) ||
    die "cannot determine whether $path is clean (git exited $rc); refusing to $action"
  [[ -n $out ]]
}

worktree_ignored_files() {
  local out rc
  out=$(cd "$1" && git ls-files --others --ignored --exclude-standard)
  rc=$?
  ((rc == 0)) || return 1
  printf '%s' "$out"
}

valid_head_oid() {
  local oid=$1
  case $oid in
    '' | *[!0-9A-Fa-f]*) return 1 ;;
  esac
  [[ ${#oid} == 40 || ${#oid} == 64 ]]
}

remote_matches_identity() {
  local remote=$1 wanted_owner=$2 wanted_repo=$3 url rest found_owner found_repo
  if ! url=$(git remote get-url "$remote" 2>/dev/null); then
    url=$remote
  fi
  url=${url%.git}
  url=${url%/}
  found_repo=${url##*/}
  rest=${url%/*}
  found_owner=${rest##*/}
  found_owner=${found_owner##*:}
  valid_identity_part "$found_owner" || return 1
  valid_identity_part "$found_repo" || return 1
  [[ $(printf '%s' "$found_owner" | tr '[:upper:]' '[:lower:]') == "$wanted_owner" ]] &&
    [[ $(printf '%s' "$found_repo" | tr '[:upper:]' '[:lower:]') == "$wanted_repo" ]]
}

pr_url_identity() {
  local url=$1 number=$2 base rest
  case $url in
    */pull/"$number") ;;
    *) return 1 ;;
  esac
  base=${url%/pull/$number}
  PR_BASE_REPO=${base##*/}
  rest=${base%/*}
  PR_BASE_OWNER=${rest##*/}
  valid_identity_part "$PR_BASE_OWNER" || return 1
  valid_identity_part "$PR_BASE_REPO" || return 1
  PR_BASE_OWNER=$(printf '%s' "$PR_BASE_OWNER" | tr '[:upper:]' '[:lower:]')
  PR_BASE_REPO=$(printf '%s' "$PR_BASE_REPO" | tr '[:upper:]' '[:lower:]')
}

branch_tracks_pr_head() {
  local branch=$1 number=$2 pr_url=$3 head_ref=$4 head_owner=$5 head_repo=$6
  local remote merge
  remote=$(git config --get "branch.$branch.remote" 2>/dev/null) || return 1
  merge=$(git config --get "branch.$branch.merge" 2>/dev/null) || return 1
  if [[ $merge == "refs/heads/$head_ref" ]]; then
    remote_matches_identity "$remote" "$head_owner" "$head_repo"
    return
  fi
  if [[ $merge == "refs/pull/$number/head" ]]; then
    pr_url_identity "$pr_url" "$number" || return 1
    remote_matches_identity "$remote" "$PR_BASE_OWNER" "$PR_BASE_REPO"
    return
  fi
  return 1
}

record_pr_markers() {
  local branch=$1 pr_url=$2 head_oid=$3 old_url old_head
  old_url=$(git config --get "branch.$branch.worktree-pr-url" 2>/dev/null) || old_url=''
  old_head=$(git config --get "branch.$branch.worktree-pr-head" 2>/dev/null) || old_head=''
  git config "branch.$branch.worktree-pr-url" "$pr_url" || return 1
  if ! git config "branch.$branch.worktree-pr-head" "$head_oid"; then
    git config --unset-all "branch.$branch.worktree-pr-url" >/dev/null 2>&1 || true
    if [[ -n $old_url ]]; then
      git config "branch.$branch.worktree-pr-url" "$old_url" >/dev/null 2>&1 || true
    fi
    if [[ -n $old_head ]]; then
      git config "branch.$branch.worktree-pr-head" "$old_head" >/dev/null 2>&1 || true
    else
      git config --unset-all "branch.$branch.worktree-pr-head" >/dev/null 2>&1 || true
    fi
    return 1
  fi
}

cleanup_pr_fetch_worktree() {
  local path=${CLWT_PR_FETCH_WORKTREE:-}
  [[ -n $path ]] || return 0
  if registered_at "$path"; then
    git worktree remove --force "$path" || return 1
  else
    rmdir "$path" 2>/dev/null || true
  fi
  CLWT_PR_FETCH_WORKTREE=''
}

# Fetches the PR through gh without touching the reusable worktree. A detached
# disposable worktree lets gh resolve same-repo, fork, and authenticated remote
# details while leaving the real branch and its ignored local files untouched.
fetch_pr_head() {
  local number=$1 expected_oid=$2 path actual
  path=$(mktemp -d "$managed_root/.clwt-pr-fetch.XXXXXX") || return 1
  CLWT_PR_FETCH_WORKTREE=$path
  if ! git worktree add --detach --quiet "$path" HEAD; then
    cleanup_pr_fetch_worktree >/dev/null 2>&1 || true
    return 1
  fi
  if ! (cd "$path" && gh pr checkout "$number" --detach); then
    cleanup_pr_fetch_worktree >/dev/null 2>&1 || true
    return 1
  fi
  actual=$(git -C "$path" rev-parse HEAD 2>/dev/null) || {
    cleanup_pr_fetch_worktree >/dev/null 2>&1 || true
    return 1
  }
  cleanup_pr_fetch_worktree || return 1
  [[ $actual == "$expected_oid" ]] || return 2
}

# Refuses every tree-shape collision that reset --hard could delete: an exact
# target object at an ignored path, or a target blob/symlink replacing a local
# directory that contains ignored files. Git evaluates each candidate set in a
# single batch; comparing every ignored path with every target-tree entry in
# Bash is prohibitively slow in repositories with large ignored dependency
# trees.
pr_ignored_paths_are_safe() {
  local target=$1 head_oid=$2 tree_file exact_file collision_file entry
  local target_path metadata rest object_type local_path check_rc=0
  local -a blocking_dirs=()
  PR_COLLISION_PATH=''
  tree_file=$(mktemp "${TMPDIR:-/tmp}/clwt-target-tree.XXXXXX") || {
    return 2
  }
  exact_file=$(mktemp "${TMPDIR:-/tmp}/clwt-exact-paths.XXXXXX") || {
    rm -f "$tree_file"
    return 2
  }
  collision_file=$(mktemp "${TMPDIR:-/tmp}/clwt-collisions.XXXXXX") || {
    rm -f "$tree_file" "$exact_file"
    return 2
  }
  if ! git -C "$target" ls-tree -r -t -z "$head_oid" >"$tree_file"; then
    rm -f "$tree_file" "$exact_file" "$collision_file"
    return 2
  fi
  while IFS= read -r -d '' entry; do
    case $entry in
      *$'\t'*) ;;
      *)
        rm -f "$tree_file" "$exact_file" "$collision_file"
        return 2
        ;;
    esac
    target_path=${entry#*$'\t'}
    metadata=${entry%%$'\t'*}
    rest=${metadata#* }
    object_type=${rest%% *}
    local_path="$target/$target_path"

    # Git tracks files and symlinks, not directories. Feed only existing
    # non-directory objects to check-ignore; a directory can collide only when
    # a non-tree target object would replace ignored content beneath it.
    if [[ -e $local_path || -L $local_path ]]; then
      if [[ ! -d $local_path || -L $local_path ]]; then
        printf '%s\0' "$target_path" >>"$exact_file" || {
          rm -f "$tree_file" "$exact_file" "$collision_file"
          return 2
        }
      elif [[ $object_type != tree ]]; then
        blocking_dirs+=("$target_path")
      fi
    fi
  done <"$tree_file"

  if [[ -s $exact_file ]]; then
    (cd "$target" && git check-ignore -z --stdin <"$exact_file" >"$collision_file") ||
      check_rc=$?
    case $check_rc in
      0 | 1) ;;
      *)
        rm -f "$tree_file" "$exact_file" "$collision_file"
        return 2
        ;;
    esac
    if [[ -s $collision_file ]]; then
      IFS= read -r -d '' PR_COLLISION_PATH <"$collision_file" || {
        rm -f "$tree_file" "$exact_file" "$collision_file"
        return 2
      }
      rm -f "$tree_file" "$exact_file" "$collision_file"
      return 1
    fi
  fi

  if ((${#blocking_dirs[@]})); then
    : >"$collision_file"
    if ! (cd "$target" && GIT_LITERAL_PATHSPECS=1 \
      git ls-files -z --others --ignored --exclude-standard -- "${blocking_dirs[@]}") \
      >"$collision_file"; then
      rm -f "$tree_file" "$exact_file" "$collision_file"
      return 2
    fi
    if [[ -s $collision_file ]]; then
      IFS= read -r -d '' PR_COLLISION_PATH <"$collision_file" || {
        rm -f "$tree_file" "$exact_file" "$collision_file"
        return 2
      }
      rm -f "$tree_file" "$exact_file" "$collision_file"
      return 1
    fi
  fi

  rm -f "$tree_file" "$exact_file" "$collision_file"
  return 0
}

reuse_pr_or_refuse() {
  local branch=$1 existing=$2 number=$3 pr_url=$4 head_oid=$5
  local head_ref=$6 head_owner=$7 head_repo=$8 cross=$9
  local marker_url marker_head legacy=0 current collision_rc final

  require_reusable_worktree "$branch" "$existing"

  marker_url=$(git config --get "branch.$branch.worktree-pr-url" 2>/dev/null) || marker_url=''
  marker_head=$(git config --get "branch.$branch.worktree-pr-head" 2>/dev/null) || marker_head=''
  if [[ -n $marker_url || -n $marker_head ]]; then
    [[ -n $marker_url && -n $marker_head ]] ||
      die "cannot verify the pull request identity for reused worktree: $existing"
    [[ $marker_url == "$pr_url" ]] ||
      die "$branch is already a worktree for a different pull request: $marker_url"
    valid_head_oid "$marker_head" ||
      die "cannot verify the previous pull request head for reused worktree: $existing"
  else
    branch_tracks_pr_head "$branch" "$number" "$pr_url" "$head_ref" "$head_owner" "$head_repo" ||
      die "cannot verify that reused worktree belongs to pull request #$number: $existing"
    legacy=1
  fi

  if worktree_is_dirty "$existing" refresh; then
    die "worktree has uncommitted or untracked work, refusing to refresh: $existing"
  fi

  local fetch_rc=0
  fetch_pr_head "$number" "$head_oid" || fetch_rc=$?
  case $fetch_rc in
    0) ;;
    2) die "pull request #$number changed while its head was being fetched; run clwt pr $number again" ;;
    *) die "gh could not fetch pull request #$number for safe reuse" ;;
  esac

  pr_ignored_paths_are_safe "$existing" "$head_oid" || collision_rc=$?
  case ${collision_rc:-0} in
    0) ;;
    1) die "ignored local path would be overwritten by pull request #$number, refusing to refresh: $PR_COLLISION_PATH" ;;
    *) die "cannot inspect ignored local paths in $existing; refusing to refresh" ;;
  esac

  current=$(git -C "$existing" rev-parse HEAD 2>/dev/null) ||
    die "cannot resolve the current head in reused worktree: $existing"
  if [[ $current == "$head_oid" ]]; then
    :
  elif git -C "$existing" merge-base --is-ancestor "$current" "$head_oid"; then
    (cd "$existing" && git merge --ff-only "$head_oid") ||
      die "could not fast-forward reused worktree to pull request #$number"
  elif ((legacy == 0)) && [[ $current == "$marker_head" ]]; then
    (cd "$existing" && git reset --hard "$head_oid") ||
      die "could not refresh rewritten pull request #$number"
  else
    die "reused worktree has local or unverifiable commits, refusing to refresh: $existing"
  fi

  final=$(git -C "$existing" rev-parse HEAD 2>/dev/null) ||
    die "cannot verify refreshed pull request #$number"
  [[ $final == "$head_oid" ]] ||
    die "refreshed worktree does not match pull request #$number; refusing to launch"
  record_pr_markers "$branch" "$pr_url" "$head_oid" ||
    die "could not record the verified identity for pull request #$number"

  note "reusing existing worktree for $branch at pull request #$number head"
  if [[ $cross == true ]]; then
    warn "pull request #$number comes from a fork — this is code you did not write, and opening it here runs it on your machine"
  fi
  launch "$existing"
}

# Removing the directory you are standing in leaves the shell in a path that no
# longer exists. Realistic, since you open a terminal in a worktree and then tidy
# up from it.
refuse_if_caller_inside() {
  local target=$1 here
  here=$(pwd -P)
  if [[ $here == "$target" || $here == "$target"/* ]]; then
    die "refusing to remove the worktree you are standing in: $target"
  fi
}

# Resolves <branch> to a managed worktree, applying every guard that must hold
# before anything destructive happens. Sets `resolved_worktree`.
resolve_removable() {
  local branch=$1 target
  validate_branch "$branch"
  target=$(branch_worktree "$branch") ||
    die "no worktree checked out for branch: $branch"
  require_managed_worktree "$target"
  target=$(cd -P "$target" && pwd -P)
  refuse_if_caller_inside "$target"
  resolved_worktree=$target
}

# Reports what removal will destroy, then removes. Shared by remove and prune.
remove_worktree() {
  local target=$1 branch=$2 delete_branch=$3
  local -a doomed=()
  local f

  local ignored
  ignored=$(worktree_ignored_files "$target") ||
    die "cannot list ignored files in $target; refusing to remove without knowing what would be destroyed"
  while IFS= read -r f; do
    if [[ -n $f ]]; then doomed+=("$f"); fi
  done <<<"$ignored"

  if ((${#doomed[@]})); then
    note "removing will destroy ${#doomed[@]} ignored file(s):"
    printf '  %s\n' "${doomed[@]}"
  fi

  git worktree remove "$target"
  note "removed $target"

  if ((delete_branch)); then
    # -d, not -D: an unmerged branch should fail loudly rather than vanish.
    git branch -d "$branch"
    note "deleted branch $branch"
  fi
}

cmd_root() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 0)) || die 'root takes no arguments'
  # A detached HEAD or a mid-rebase primary has no branch to name the session
  # after — leave LAUNCH_NAME empty rather than dying, since launching in the
  # primary checkout must still work in that state.
  local branch
  if branch=$(git -C "$primary" symbolic-ref --quiet --short HEAD 2>/dev/null); then
    LAUNCH_NAME=$(worktree_name_for_branch "$branch")
  fi
  launch "$primary"
}

# Probed once, up front — never inferred from a failing per-branch query. A branch
# with no PR and a closed-but-unmerged PR both make `gh pr view` exit non-zero,
# which is the same signal an unauthenticated gh gives. Conflating them either
# turns a broken gh into a silent "nothing to prune", or turns every PR-less
# branch into a deletion candidate. Neither is acceptable for a bulk delete.
require_gh() {
  local what=$1
  command -v gh >/dev/null 2>&1 ||
    die "$what needs gh to reach GitHub, but gh is not on PATH"
  gh auth status >/dev/null 2>&1 ||
    die "$what needs gh to reach GitHub, but gh is not authenticated (run: gh auth login)"
}

# MERGED / OPEN / CLOSED, or NONE when the branch has no pull request. Safe to
# read a non-zero exit as "no PR" only because require_gh already established
# that gh itself works.
branch_pr_state() {
  gh pr view "$1" --json state --jq '.state' 2>/dev/null || printf 'NONE\n'
}

cmd_prune() {
  local apply=0

  while [[ $# -gt 0 ]]; do
    case $1 in
      --yes) apply=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*) die "unknown option: $1 (run 'clwt help')" ;;
      *) die 'prune takes no positional arguments' ;;
    esac
    shift
  done

  require_gh prune

  local line path='' branch='' physical state here i
  local -a ripe_branches=() ripe_paths=() skipped=()
  here=$(pwd -P)

  while IFS= read -r line; do
    case $line in
      'worktree '*)
        path=${line#worktree }
        branch=''
        ;;
      'branch refs/heads/'*)
        branch=${line#branch refs/heads/}
        ;;
      '')
        # The `!= "$primary"` term is deliberately redundant with the managed-root
        # check below — the primary checkout does not live under the managed root,
        # so containment already excludes it. Kept as defense in depth on the only
        # bulk-delete path in the tool. Do not remove it as dead code.
        if [[ -n $path && -n $branch && $path != "$primary" && ! -L $path ]]; then
          case $path in
            "$managed_root"/*)
              physical=$(cd -P "$path" 2>/dev/null && pwd -P) || physical=''
              if [[ -n $physical ]]; then
                if [[ $here == "$physical" || $here == "$physical"/* ]]; then
                  skipped+=("$branch — you are standing in it")
                elif worktree_is_dirty "$physical"; then
                  skipped+=("$branch — uncommitted or untracked work")
                else
                  state=$(branch_pr_state "$branch")
                  if [[ $state == MERGED ]]; then
                    ripe_branches+=("$branch")
                    ripe_paths+=("$physical")
                  else
                    skipped+=("$branch — pull request is $state")
                  fi
                fi
              fi
              ;;
          esac
        fi
        path=''
        ;;
    esac
  done < <(
    git worktree list --porcelain
    printf '\n'
  )

  if ((${#skipped[@]})); then
    note "left alone (${#skipped[@]}):"
    printf '  %s\n' "${skipped[@]}"
  fi

  if ((${#ripe_branches[@]} == 0)); then
    note 'nothing to prune'
    return 0
  fi

  if ((apply == 0)); then
    note "would remove ${#ripe_branches[@]} worktree(s) — re-run with --yes to apply:"
    for i in "${!ripe_branches[@]}"; do
      printf '  %s  %s\n' "${ripe_branches[i]}" "${ripe_paths[i]}"
    done
    return 0
  fi

  # Branches are kept: the worktree is disposable, the branch is history.
  for i in "${!ripe_branches[@]}"; do
    remove_worktree "${ripe_paths[i]}" "${ripe_branches[i]}" 0
  done
}

# Query canonical PR identity before doing anything. A fresh checkout then
# verifies both the local branch name and exact head object before it records
# reusable markers. Existing PR worktrees take a separate path: fetch detached
# into a disposable worktree, prove the real worktree is clean and belongs to
# this PR, then fast-forward or reset from its last verified head.
cmd_pr() {
  # `--force` is pr-only — parse_launch_args must not learn it, or
  # branch/new/open/root silently start accepting it too. Stripped here, before
  # the remainder reaches the shared parser. Stops at the first `--`: from
  # there on every argument belongs to claude (the `--` contract the shared
  # parser itself implements), and scanning the whole argv would misread
  # `clwt pr 12 -- --force` as a request to reset the branch instead of
  # forwarding a literal --force to claude.
  local -a rest=()
  local force=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --)
        rest+=("$@")
        break
        ;;
      --force)
        force=1
        ;;
      *)
        rest+=("$1")
        ;;
    esac
    shift
  done

  # Two literal calls, not a guarded "${rest[@]}" expansion: under `set -u`,
  # expanding an empty array errors on bash older than 4.4 — the same hazard
  # the guarded-array precedent in launch() exists to avoid.
  if ((${#rest[@]})); then
    parse_launch_args "${rest[@]}"
  else
    parse_launch_args
  fi
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'pr requires exactly one pull request number'

  local number=${LAUNCH_POSITIONAL[0]} meta head_ref cross head_owner head_repo
  local pr_url head_oid name target
  case $number in
    '' | *[!0-9]*) die "pull request must be a number: $number" ;;
  esac
  # Named from the validated PR NUMBER, never from head_ref or the worktree
  # directory name below — both describe the fork's own head branch, so a
  # hostile PR could otherwise choose its own session name.
  LAUNCH_NAME="PR-$number"

  require_gh pr

  meta=$(gh pr view "$number" \
    --json headRefName,isCrossRepository,headRepositoryOwner,headRepository,url,headRefOid \
    --jq '.headRefName, .isCrossRepository, .headRepositoryOwner.login, .headRepository.name, .url, .headRefOid' 2>/dev/null) ||
    die "cannot resolve pull request #$number"
  head_ref=$(printf '%s\n' "$meta" | sed -n 1p)
  cross=$(printf '%s\n' "$meta" | sed -n 2p)
  # Case-folded on both sides: GitHub reports the canonical spelling, while the
  # clone URL keeps whatever the developer typed. An unfolded compare would
  # silently withhold auto-force forever from anyone whose remote reads
  # `ItsACoyote/…`, and the plain path gives no hint why.
  head_owner=$(printf '%s\n' "$meta" | sed -n 3p | tr '[:upper:]' '[:lower:]')
  head_repo=$(printf '%s\n' "$meta" | sed -n 4p | tr '[:upper:]' '[:lower:]')
  pr_url=$(printf '%s\n' "$meta" | sed -n 5p)
  head_oid=$(printf '%s\n' "$meta" | sed -n 6p)
  [[ -n $head_ref ]] || die "pull request #$number has no head branch"
  # head_ref is fork-controlled input, unvalidated before this point — reject a
  # malicious ref name before it reaches branch_worktree or any other git command.
  validate_branch "$head_ref"
  # Anything other than a literal true/false would otherwise reach the
  # auto-force decision below unvalidated — fail closed by naming the only two
  # values that decision can trust.
  [[ $cross == true || $cross == false ]] ||
    die "cannot determine whether pull request #$number comes from a fork"
  pr_url_identity "$pr_url" "$number" ||
    die "pull request #$number returned an invalid canonical URL"
  valid_head_oid "$head_oid" ||
    die "pull request #$number returned an invalid head object ID"

  local existing
  if existing=$(branch_worktree "$head_ref"); then
    reuse_pr_or_refuse "$head_ref" "$existing" "$number" "$pr_url" "$head_oid" \
      "$head_ref" "$head_owner" "$head_repo" "$cross"
  fi

  # Captured UNCONDITIONALLY, outside the $cross gate below: only the
  # auto-force DECISION is gated on cross, but the die-hint after a failed
  # checkout further down needs this fact for a fork PR too. A three-term &&
  # that short-circuited on $cross would leave it unset there and silence the
  # hint on exactly the fork + coincidentally-same-named-local-branch failure
  # it exists to serve. (reuse_or_refuse above already owns the case where the
  # branch is checked out somewhere, so "exists" here means "exists, unheld".)
  local branch_existed=0
  if git show-ref --verify --quiet "refs/heads/$head_ref"; then
    branch_existed=1
  fi

  # Four required terms, all gating the DECISION only (branch_existed itself
  # stays ungated, see above): not cross-repository — a fork's head ref name
  # can coincide with an unrelated base-repo branch, so containment there
  # would prove nothing about the fork's actual head, and fork PRs always take
  # the plain path; origin is the repository the head actually lives in; a
  # pre-existing local branch to reset; and that branch provably contained in
  # the pre-fetch origin tip. `((! force))` short-circuits the whole probe for
  # an explicit --force, which already means reset and needs no safety check.
  #
  # The identity term is not implied by the cross-repository one. gh resolves
  # the pull request's repository on its own, with no regard for which remote a
  # clone happens to call origin. In a fork workflow — origin your fork,
  # upstream the base repo — a NON-cross-repository pull request still means
  # "head lives in upstream", and refs/remotes/origin/<branch> is then a
  # same-named branch in a different repository entirely. Containment against
  # it proves nothing about the pull request, and the reset would be judged
  # against unrelated commits.
  local auto_force=0
  if ((! force)) && [[ $cross == false ]] &&
    [[ $head_owner == "$(printf '%s' "$owner" | tr '[:upper:]' '[:lower:]')" ]] &&
    [[ $head_repo == "$(printf '%s' "$repo" | tr '[:upper:]' '[:lower:]')" ]] &&
    ((branch_existed)) && branch_contained_in_origin "$head_ref"; then
    auto_force=1
  fi

  name=$(worktree_name_for_branch "$head_ref")
  validate_worktree_name "$name"
  target="$managed_root/$name"
  ensure_available_path "$target"
  mkdir -p "$managed_root"

  # Detached, because `gh pr checkout` is what decides the branch — for a fork it
  # may pick a local name of its own.
  git worktree add --detach --quiet "$target" HEAD
  # Two literal invocations for the same "${rest[@]}"-under-set-u reason as the
  # arg-parsing pre-pass above — `gh pr checkout "$number" "${arr[@]}"` with an
  # empty $arr errors on bash older than 4.4.
  local checkout_ok=1
  if ((force || auto_force)); then
    if ((auto_force)); then
      note "resetting $head_ref — it has no local-only commits"
    fi
    (cd "$target" && gh pr checkout "$number" --force) || checkout_ok=0
  else
    (cd "$target" && gh pr checkout "$number") || checkout_ok=0
  fi
  if ((! checkout_ok)); then
    # Clean up rather than leaving a half-made worktree. This is not theoretical:
    # `clwt pr` against a merged pull request whose head branch has since been
    # deleted fails exactly here, and an orphaned worktree makes the retry fail
    # for a second, unrelated-looking reason.
    git worktree remove --force "$target" 2>/dev/null || true
    # Only worth the hint when a local branch was actually in the way — the
    # captured, pre-fetch fact, not a re-check now that gh has already run and
    # moved the tracking ref out from under a re-check. Also gated on !force
    # and !auto_force: a failed checkout that already ran WITH --force (explicit
    # or auto) means resetting the branch is exactly what just failed to help,
    # so re-suggesting the same --force would be circular.
    local hint=''
    if ((branch_existed && ! force && ! auto_force)); then
      hint=" — $head_ref may have diverged from the pull request; run 'clwt pr $number --force' to reset it"
    fi
    die "gh could not check out pull request #$number$hint"
  fi

  local checked_out_branch checked_out_head
  checked_out_branch=$(git -C "$target" symbolic-ref --quiet --short HEAD 2>/dev/null) || {
    abandon_worktree "$target"
    die "gh did not check pull request #$number out on its head branch"
  }
  if [[ $checked_out_branch != "$head_ref" ]]; then
    abandon_worktree "$target"
    die "gh checked pull request #$number out as $checked_out_branch instead of $head_ref"
  fi
  checked_out_head=$(git -C "$target" rev-parse HEAD 2>/dev/null) || {
    abandon_worktree "$target"
    die "cannot verify the checked-out head for pull request #$number"
  }
  if [[ $checked_out_head != "$head_oid" ]]; then
    abandon_worktree "$target"
    die "pull request #$number changed while it was being checked out; run clwt pr $number again"
  fi

  copy_worktree_includes "$target" || {
    abandon_worktree "$target"
    die "could not prepare the worktree for pull request #$number"
  }

  record_pr_markers "$head_ref" "$pr_url" "$head_oid" || {
    abandon_worktree "$target"
    die "could not record the verified identity for pull request #$number"
  }

  if [[ $cross == true ]]; then
    printf '%s: WARNING: pull request #%s comes from a fork — this is code you did not write, and opening it here runs it on your machine\n' \
      "$PROGRAM" "$number" >&2
  fi

  launch "$target"
}

cmd_remove() {
  local branch='' delete_branch=0

  while [[ $# -gt 0 ]]; do
    case $1 in
      --delete-branch) delete_branch=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*) die "unknown option: $1 (run 'clwt help')" ;;
      *)
        [[ -z $branch ]] || die 'remove takes exactly one branch name'
        branch=$1
        ;;
    esac
    shift
  done
  [[ -n $branch ]] || die 'remove requires a branch name'

  resolve_removable "$branch"
  if worktree_is_dirty "$resolved_worktree"; then
    die "worktree has uncommitted or untracked work, refusing to remove: $resolved_worktree"
  fi
  remove_worktree "$resolved_worktree" "$branch" "$delete_branch"
}

cmd_branch() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'branch requires exactly one branch name'

  local branch=${LAUNCH_POSITIONAL[0]} existing name target
  validate_branch "$branch"
  name=$(worktree_name_for_branch "$branch")
  # Set before the reuse early-return so the reused-worktree path and the
  # fresh-worktree path below both launch under the same name.
  LAUNCH_NAME=$name

  if existing=$(branch_worktree "$branch"); then
    reuse_or_refuse "$branch" "$existing"
  fi

  validate_worktree_name "$name"
  target="$managed_root/$name"
  ensure_available_path "$target"
  mkdir -p "$managed_root"

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$target" "$branch"
  else
    note "fetching origin/$branch"
    remote_git fetch --quiet origin "refs/heads/$branch:refs/remotes/origin/$branch" ||
      die "could not fetch origin/$branch: not on origin, or origin unreachable"
    git worktree add -b "$branch" "$target" "origin/$branch"
  fi

  copy_worktree_includes "$target" || {
    abandon_worktree "$target"
    die "could not prepare the worktree for $branch"
  }
  launch "$target"
}

cmd_new() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'new requires exactly one branch name'

  local branch=${LAUNCH_POSITIONAL[0]} existing base name target
  validate_branch "$branch"
  [[ $branch == */* ]] ||
    die "new needs a typed branch name such as feat/account-recovery or fix/login-timeout"
  name=$(worktree_name_for_branch "$branch")
  LAUNCH_NAME=$name

  if existing=$(branch_worktree "$branch"); then
    reuse_or_refuse "$branch" "$existing"
  fi

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    die "local branch already exists but is not checked out: $branch (use 'clwt branch $branch')"
  fi

  validate_worktree_name "$name"
  target="$managed_root/$name"
  ensure_available_path "$target"

  note "resolving origin's default branch"
  base=$(default_remote_branch)
  note "fetching origin/$base"
  remote_git fetch --quiet origin "refs/heads/$base:refs/remotes/origin/$base"

  mkdir -p "$managed_root"
  git worktree add -b "$branch" "$target" "origin/$base"
  copy_worktree_includes "$target" || {
    abandon_worktree "$target"
    die "could not prepare the worktree for $branch"
  }
  launch "$target"
}

cmd_open() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'open requires exactly one branch name'

  local branch=${LAUNCH_POSITIONAL[0]} target
  validate_branch "$branch"
  LAUNCH_NAME=$(worktree_name_for_branch "$branch")
  target=$(branch_worktree "$branch") ||
    die "no worktree checked out for branch: $branch"
  require_managed_worktree "$target"
  launch "$target"
}

# Lists this repository's worktrees, marking any that live outside the managed
# root. Those exist because Claude Code's own worktree feature is still available
# and does not consult clwt — showing them, flagged, is more honest than hiding
# worktrees the developer can plainly see in `git worktree list`.
cmd_list() {
  [[ $# -eq 0 ]] || die 'list takes no arguments'

  local line path='' branch='' width=0
  local -a listed_branches=() listed_paths=() listed_marks=()

  while IFS= read -r line; do
    case $line in
      'worktree '*)
        path=${line#worktree }
        branch='(detached)'
        ;;
      'branch refs/heads/'*)
        branch=${line#branch refs/heads/}
        ;;
      '')
        # Blank line terminates a record. The primary checkout is a worktree as
        # far as git is concerned, but it is not one clwt manages.
        if [[ -n $path && $path != "$primary" ]]; then
          listed_branches+=("$branch")
          listed_paths+=("$path")
          case $path in
            "$managed_root"/*) listed_marks+=('') ;;
            *) listed_marks+=('(unmanaged)') ;;
          esac
          if ((${#branch} > width)); then width=${#branch}; fi
        fi
        path=''
        ;;
    esac
  done < <(
    git worktree list --porcelain
    printf '\n'
  )

  if ((${#listed_branches[@]} == 0)); then
    printf 'No managed worktrees for %s/%s.\n' "$owner" "$repo"
    return 0
  fi

  local i
  for i in "${!listed_branches[@]}"; do
    if [[ -n ${listed_marks[i]} ]]; then
      printf '%-*s  %s  %s\n' "$width" "${listed_branches[i]}" "${listed_paths[i]}" "${listed_marks[i]}"
    else
      printf '%-*s  %s\n' "$width" "${listed_branches[i]}" "${listed_paths[i]}"
    fi
  done
}

# Resolves this script's real path, following symlinks by hand. `readlink -f` would
# do it in one call but is GNU-only, and this library is copied onto machines we do
# not control. Matters because `clwt install` is normally run *through* the symlink
# it installed — without this it would happily point the symlink at itself.
resolve_self() {
  local src=$0 dir
  case $src in
    */*) ;;
    *) src=$(command -v -- "$src" 2>/dev/null) || src=$0 ;;
  esac
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd -P)
    src=$(readlink "$src")
    case $src in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  dir=$(cd -P "$(dirname "$src")" && pwd -P)
  printf '%s/%s\n' "$dir" "$(basename "$src")"
}

path_contains() {
  case ":${PATH-}:" in
    *":$1:"*) return 0 ;;
  esac
  return 1
}

# Symlinks — deliberately, not copies. A symlink tracks every later edit to the
# repo script, so the tool stays current as the library is updated, and there is
# never a stale duplicate to wonder about.
# Points <target> at <source>, creating the parent directory, repointing a
# symlink that aims elsewhere, and refusing to clobber anything that is not a
# symlink — a real file there belongs to someone else.
link_into_place() {
  local source=$1 target=$2 current

  mkdir -p "${target%/*}" || die "cannot create ${target%/*}"

  if [[ -L $target ]]; then
    current=$(readlink "$target")
    if [[ $current == "$source" ]]; then
      note "already installed: $target -> $source"
      return 0
    fi
    ln -sfn "$source" "$target" || die "cannot update symlink: $target"
    note "repointed $target -> $source"
    return 0
  fi

  [[ ! -e $target ]] ||
    die "$target exists and is not a symlink; move it aside and retry"

  ln -s "$source" "$target" || die "cannot create symlink: $target"
  note "installed $target -> $source"
}

cmd_install() {
  [[ $# -eq 0 ]] || die 'install takes no arguments'

  local bin_dir="$HOME/.local/bin"
  local source completion_source completion_dir
  source=$(resolve_self)
  completion_source="${source%/*}/clwt-completion.bash"

  link_into_place "$source" "$bin_dir/clwt"

  # bash-completion 2.x autoloads a file named after the command from here, so
  # Tab works in a new shell with no rc edit. A symlink rather than a copy, for
  # the same reason as the binary: it tracks later edits.
  completion_dir="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
  if [[ -f $completion_source ]]; then
    link_into_place "$completion_source" "$completion_dir/clwt"
  else
    note "no completion script beside clwt, skipping: $completion_source"
  fi

  install_path_warning "$bin_dir"
}

install_path_warning() {
  path_contains "$1" && return 0
  printf '%s: warning: %s is not on your PATH; add it to use `clwt` directly\n' \
    "$PROGRAM" "$1" >&2
}

# Undocumented diagnostic seam: prints the resolved foundation values so the test
# suite (and a confused human) can see what clwt thinks it is working with.
cmd_debug_roots() {
  printf 'owner=%s\n' "$owner"
  printf 'repo=%s\n' "$repo"
  printf 'primary=%s\n' "$primary"
  printf 'managed_root=%s\n' "$managed_root"
}

main() {
  local command=${1:-list}
  case $command in
    -h | --help | help)
      usage
      ;;
    debug-roots)
      require_repo
      cmd_debug_roots
      ;;
    list)
      shift || true
      require_repo
      cmd_list "$@"
      ;;
    install)
      shift || true
      cmd_install "$@" # deliberately no require_repo; install is repo-independent
      ;;
    root | open | new | branch | remove | prune | pr)
      shift || true
      require_repo
      "cmd_$command" "$@"
      ;;
    *)
      die "unknown command: $command (run 'clwt help')"
      ;;
  esac
}

main "$@"
