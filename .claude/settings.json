{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/beads-gate.sh",
            "type": "command"
          },
          {
            "command": "bash .claude/hooks/session-orient.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git switch -c *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(gh pr *)",
      "Bash(bd --version)",
      "Bash(bd version *)",
      "Bash(bd init *)",
      "Bash(bd doctor *)",
      "Bash(bd config *)",
      "Bash(bd create *)",
      "Bash(bd list *)",
      "Bash(bd ready *)",
      "Bash(bd show *)",
      "Bash(bd blocked *)",
      "Bash(bd update *)",
      "Bash(bd close *)"
    ],
    "deny": [
      "Bash(git -C *)"
    ]
  },
  "statusLine": {
    "command": "bash statusline-command.sh",
    "type": "command"
  }
}