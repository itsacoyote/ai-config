{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itsacoyote.dev/ai-config/qa-result.schema.json",
  "title": "Portable QA result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "attempt",
    "summary",
    "evidence",
    "failing_command",
    "affected_paths",
    "implementer_instructions",
    "blocker"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "verdict": { "enum": ["APPROVED", "FIX_REQUIRED", "BLOCKED"] },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "failing_command": { "type": ["string", "null"] },
    "affected_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "implementer_instructions": { "type": ["string", "null"] },
    "blocker": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "FIX_REQUIRED" } } },
      "then": {
        "properties": {
          "evidence": { "minItems": 1 },
          "failing_command": { "type": "string", "minLength": 1 },
          "affected_paths": { "minItems": 1 },
          "implementer_instructions": { "type": "string", "minLength": 1 },
          "blocker": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "APPROVED" } } },
      "then": {
        "properties": {
          "failing_command": { "type": "null" },
          "affected_paths": { "maxItems": 0 },
          "implementer_instructions": { "type": "null" },
          "blocker": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "BLOCKED" } } },
      "then": {
        "properties": {
          "implementer_instructions": { "type": "null" },
          "blocker": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
