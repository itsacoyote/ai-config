#!/bin/bash
set -euo pipefail

PWT_ORIGINAL_PATH=${PATH:-}
PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin
export PATH

PROGRAM=${0##*/}
pi_arg_count=0

usage() {
  cat <<'EOF'
Usage:
  pwt new <branch> [-- <pi-args...>]
  pwt branch <branch> [-- <pi-args...>]
  pwt open <branch> [-- <pi-args...>]
  pwt list
  pwt remove <branch> [--delete-branch]
  pwt help [command]
  pwt -h | --help

Create and manage centrally organized Git worktrees, then launch Pi with the
selected worktree as its real working directory.

Commands:
  new       Create an explicitly named branch from the remote default and run Pi.
  branch    Check out or reuse a managed local/remote branch and run Pi.
  open      Run Pi in an existing managed worktree by branch name.
  list      List this repository's managed worktrees.
  remove    Remove a clean managed worktree; keep its branch by default.
  help      Show general or command-specific help.

Managed paths:
  ~/github/.worktrees/<owner>/<repo>/<name>/

Examples:
  pwt new feat/account-recovery
  pwt new fix/login-timeout -- --name "login timeout"
  pwt branch fix/login-timeout
  pwt open feat/account-recovery
  pwt list
  pwt remove feat/account-recovery
  pwt remove feat/account-recovery --delete-branch

PR review is intentionally not included yet. It requires a verified external
sandbox before Pi can safely inspect untrusted pull-request content.
EOF
}

command_usage() {
  case ${1:-} in
    new)
      cat <<'EOF'
Usage: pwt new <branch> [-- <pi-args...>]

Create the explicitly named branch from the latest origin default branch in the
managed worktree directory, then launch Pi there. Include the branch type, such
as feat/account-recovery or fix/login-timeout. If that branch is already checked
out in a managed worktree, reuse it; refuse checkouts outside the managed root.
EOF
      ;;
    branch)
      cat <<'EOF'
Usage: pwt branch <branch> [-- <pi-args...>]

Fetch and check out an existing local or origin branch in the managed worktree
directory, then launch Pi there. If the branch is already checked out in a
managed worktree, reuse it; refuse checkouts outside the managed root.
EOF
      ;;
    open)
      cat <<'EOF'
Usage: pwt open <branch> [-- <pi-args...>]

Launch Pi in an existing managed worktree by its Git branch name.
EOF
      ;;
    list)
      printf '%s\n' 'Usage: pwt list' '' "List managed worktrees for the current repository."
      ;;
    remove)
      cat <<'EOF'
Usage: pwt remove <branch> [--delete-branch]

Remove a managed worktree by its Git branch name only when it has no tracked,
untracked, or ignored content changes. The local branch is kept unless
--delete-branch is supplied;
branch deletion uses Git's safe -d check and therefore refuses unmerged branches.
EOF
      ;;
    help|-h|--help|'') usage ;;
    *) die "unknown command for help: $1" ;;
  esac
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 2
}

require_repo() {
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die 'run pwt from inside a Git repository'
  remote_url=$(git -C "$repo_root" remote get-url origin 2>/dev/null) || die 'repository has no origin remote'

  identity=$(python3 -I - "$remote_url" <<'PY'
import re
import sys
from urllib.parse import urlparse

value = sys.argv[1]
if re.match(r"^[^/@:]+@[^:]+:", value):
    path = value.split(":", 1)[1]
else:
    parsed = urlparse(value)
    path = parsed.path if parsed.scheme else value
parts = [part for part in path.strip("/").removesuffix(".git").split("/") if part]
if len(parts) < 2:
    raise SystemExit(1)
owner, repo = parts[-2:]
valid = re.compile(r"^[A-Za-z0-9._-]+$")
if not valid.fullmatch(owner) or not valid.fullmatch(repo) or owner in {".", ".."} or repo in {".", ".."}:
    raise SystemExit(1)
print(owner)
print(repo)
PY
  ) || die "cannot derive owner/repository from origin: $remote_url"

  owner=${identity%%$'\n'*}
  repo=${identity#*$'\n'}
  managed_root="$HOME/github/.worktrees/$owner/$repo"
  mkdir -p "$managed_root"
  managed_root=$(cd "$managed_root" && pwd -P)
}

validate_name() {
  local value=$1 label=$2
  [[ $value =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die "$label must use letters, numbers, dots, underscores, or hyphens"
  [[ $value != *..* ]] || die "$label must not contain '..'"
}

validate_branch() {
  git check-ref-format --branch "$1" >/dev/null 2>&1 || die "invalid branch name: $1"
}

split_pi_args() {
  pi_args=()
  pi_arg_count=0
  if [[ $# -gt 0 ]]; then
    [[ $1 == -- ]] || die "unexpected argument: $1 (put Pi arguments after --)"
    shift
    pi_args=("$@")
    pi_arg_count=$#
  fi
}

sanitize_execution_path() {
  PATH=$(python3 -I - "$repo_root" "$managed_root" "$PWT_ORIGINAL_PATH" <<'PY'
import os
import stat
import sys

blocked = [os.path.realpath(value) for value in sys.argv[1:3]]
result = []
for value in sys.argv[3].split(os.pathsep):
    if not value or not os.path.isabs(value):
        continue
    path = os.path.realpath(value)
    if not os.path.isdir(path):
        continue
    if any(path == root or path.startswith(root + os.sep) for root in blocked):
        continue
    metadata = os.stat(path)
    mode = stat.S_IMODE(metadata.st_mode)
    if metadata.st_uid not in {0, os.geteuid()} or mode & 0o022:
        continue
    if path not in result:
        result.append(path)
if not result:
    raise SystemExit(1)
print(os.pathsep.join(result))
PY
  ) || die 'PATH has no trusted absolute executable directories'
  export PATH
}

validate_executable() {
  python3 -I - "$1" "$repo_root" "$managed_root" <<'PY'
import os
import stat
import sys

path = os.path.realpath(sys.argv[1])
blocked = [os.path.realpath(value) for value in sys.argv[2:]]
if any(path == root or path.startswith(root + os.sep) for root in blocked):
    raise SystemExit(1)
metadata = os.stat(path)
if not stat.S_ISREG(metadata.st_mode) or not os.access(path, os.X_OK):
    raise SystemExit(1)
if metadata.st_uid not in {0, os.geteuid()} or stat.S_IMODE(metadata.st_mode) & 0o022:
    raise SystemExit(1)
parent = os.path.dirname(path)
while True:
    value = os.stat(parent)
    mode = stat.S_IMODE(value.st_mode)
    if value.st_uid not in {0, os.geteuid()} or mode & 0o020 or (mode & 0o002 and not mode & stat.S_ISVTX):
        raise SystemExit(1)
    next_parent = os.path.dirname(parent)
    if next_parent == parent:
        break
    parent = next_parent
print(path)
PY
}

resolve_pi() {
  local candidate first_line interpreter_name interpreter_candidate
  sanitize_execution_path
  candidate=$(command -v pi 2>/dev/null) || die 'pi executable not found on trusted PATH'
  pi_bin=$(validate_executable "$candidate") || die 'pi executable has unsafe provenance, ownership, or permissions'
  pi_interpreter=
  IFS= read -r first_line <"$pi_bin" || true
  case $first_line in
    '#!/usr/bin/env '*)
      interpreter_name=${first_line#'#!/usr/bin/env '}
      [[ $interpreter_name =~ ^[A-Za-z0-9._+-]+$ ]] || die 'unsupported /usr/bin/env Pi shebang'
      interpreter_candidate=$(command -v "$interpreter_name" 2>/dev/null) || die "Pi interpreter not found: $interpreter_name"
      pi_interpreter=$(validate_executable "$interpreter_candidate") || die 'Pi interpreter has unsafe provenance, ownership, or permissions'
      ;;
  esac
}

launch_pi() {
  local path=$1
  shift
  require_managed_worktree "$path"
  resolve_pi
  printf 'pwt: launching Pi in %s\n' "$path"
  cd -P "$path"
  if [[ -n $pi_interpreter ]]; then
    exec "$pi_interpreter" "$pi_bin" "$@"
  fi
  exec "$pi_bin" "$@"
}

launch_selected() {
  local path=$1
  if [[ $pi_arg_count -gt 0 ]]; then
    launch_pi "$path" "${pi_args[@]}"
  else
    launch_pi "$path"
  fi
}

branch_worktree() {
  local wanted=$1
  git -C "$repo_root" worktree list --porcelain | awk -v wanted="refs/heads/$wanted" '
    /^worktree / { path = substr($0, 10) }
    /^branch / && substr($0, 8) == wanted { print path; exit }
  '
}

registered_at() {
  local wanted=$1
  git -C "$repo_root" worktree list --porcelain | awk -v wanted="$wanted" '
    /^worktree / && substr($0, 10) == wanted { found = 1 }
    END { exit found ? 0 : 1 }
  '
}

require_managed_worktree() {
  local path=$1 physical
  [[ ! -L $path ]] || die "managed worktree must not be a symlink: $path"
  physical=$(cd -P "$path" 2>/dev/null && pwd -P) || die "cannot resolve worktree directory: $path"
  case $physical in
    "$managed_root"/*) ;;
    *) die "worktree resolves outside the managed root: $path -> $physical" ;;
  esac
}

ensure_available_path() {
  local path=$1
  if [[ -L $path ]]; then
    die "managed worktree path must not be a symlink: $path"
  fi
  if [[ -e $path ]] && ! registered_at "$path"; then
    die "path exists but is not a registered worktree: $path"
  fi
}

default_remote_branch() {
  local ref
  ref=$(git -C "$repo_root" ls-remote --symref origin HEAD 2>/dev/null | awk '$1 == "ref:" && $2 ~ /^refs\/heads\// { sub(/^refs\/heads\//, "", $2); print $2; exit }')
  [[ -n $ref ]] || die 'cannot determine the current origin default branch'
  validate_branch "$ref"
  printf '%s\n' "$ref"
}

worktree_name_for_branch() {
  printf '%s\n' "$1" | tr '/' '-'
}

cmd_new() {
  [[ $# -gt 0 ]] || { command_usage new; exit 2; }
  [[ $1 != -h && $1 != --help ]] || { command_usage new; exit 0; }
  local branch=$1
  shift
  validate_branch "$branch"
  [[ $branch == */* ]] || die "new requires a full branch name such as feat/account-recovery or fix/login-timeout"
  split_pi_args "$@"

  local existing base name target
  existing=$(branch_worktree "$branch")
  if [[ -n $existing ]]; then
    require_managed_worktree "$existing"
    launch_selected "$existing"
  fi
  git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch" && die "local branch already exists but is not checked out: $branch; use 'pwt branch $branch'"

  base=$(default_remote_branch)
  printf 'pwt: fetching origin/%s\n' "$base"
  git -C "$repo_root" fetch --quiet origin "refs/heads/$base:refs/remotes/origin/$base"
  mkdir -p "$managed_root"
  name=$(worktree_name_for_branch "$branch")
  validate_name "$name" 'derived worktree name'
  target="$managed_root/$name"
  ensure_available_path "$target"
  git -C "$repo_root" worktree add -b "$branch" "$target" "origin/$base"
  launch_selected "$target"
}

cmd_branch() {
  [[ $# -gt 0 ]] || { command_usage branch; exit 2; }
  [[ $1 != -h && $1 != --help ]] || { command_usage branch; exit 0; }
  local branch=$1
  shift
  validate_branch "$branch"
  split_pi_args "$@"

  local existing name target
  existing=$(branch_worktree "$branch")
  if [[ -n $existing ]]; then
    require_managed_worktree "$existing"
    launch_selected "$existing"
  fi

  name=$(worktree_name_for_branch "$branch")
  validate_name "$name" 'derived worktree name'
  mkdir -p "$managed_root"
  target="$managed_root/$name"
  ensure_available_path "$target"

  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo_root" worktree add "$target" "$branch"
  else
    printf 'pwt: fetching origin/%s\n' "$branch"
    git -C "$repo_root" fetch --quiet origin "refs/heads/$branch:refs/remotes/origin/$branch" || die "remote branch not found: origin/$branch"
    git -C "$repo_root" worktree add --track -b "$branch" "$target" "origin/$branch"
  fi
  launch_selected "$target"
}

cmd_open() {
  [[ $# -gt 0 ]] || { command_usage open; exit 2; }
  [[ $1 != -h && $1 != --help ]] || { command_usage open; exit 0; }
  local branch=$1
  shift
  validate_branch "$branch"
  split_pi_args "$@"
  local target
  target=$(branch_worktree "$branch")
  [[ -n $target ]] || die "managed worktree not found for branch: $branch"
  require_managed_worktree "$target"
  launch_selected "$target"
}

cmd_list() {
  [[ $# -eq 0 ]] || die "list takes no arguments"
  mkdir -p "$managed_root"
  python3 -I - "$repo_root" "$managed_root" <<'PY'
import subprocess
import sys

repo, managed = sys.argv[1:]
output = subprocess.run(
    ["git", "-C", repo, "worktree", "list", "--porcelain"],
    check=True,
    text=True,
    capture_output=True,
).stdout
records = []
record = {}
for line in output.splitlines() + [""]:
    if not line:
        if record.get("worktree", "").startswith(managed + "/"):
            branch = record.get("branch", "(detached)").removeprefix("refs/heads/")
            records.append((branch, record["worktree"]))
        record = {}
    elif " " in line:
        key, value = line.split(" ", 1)
        record[key] = value
if not records:
    print("No managed worktrees for this repository.")
else:
    width = max(len(branch) for branch, _ in records)
    for branch, path in records:
        print(f"{branch:<{width}}  {path}")
PY
}

cmd_remove() {
  [[ $# -gt 0 ]] || { command_usage remove; exit 2; }
  [[ $1 != -h && $1 != --help ]] || { command_usage remove; exit 0; }
  local requested_branch=$1 delete_branch=0
  shift
  validate_branch "$requested_branch"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --delete-branch) delete_branch=1 ;;
      -h|--help) command_usage remove; exit 0 ;;
      *) die "unknown remove option: $1" ;;
    esac
    shift
  done

  local target branch_ref branch
  target=$(branch_worktree "$requested_branch")
  [[ -n $target ]] || die "managed worktree not found for branch: $requested_branch"
  require_managed_worktree "$target"
  branch_ref=$(git -C "$target" symbolic-ref --quiet HEAD 2>/dev/null || true)
  branch=${branch_ref#refs/heads/}
  # This final check must remain immediately adjacent to removal. Do not remove a
  # worktree while editors, generators, or development servers are using it.
  [[ -z $(git -C "$target" status --porcelain --untracked-files=all --ignored) ]] || die "worktree contains tracked, untracked, or ignored local data: $target"
  git -C "$repo_root" worktree remove "$target"
  printf 'pwt: removed %s\n' "$target"

  if [[ $delete_branch -eq 1 ]]; then
    [[ -n $branch_ref ]] || die 'removed worktree was detached; no local branch to delete'
    git -C "$repo_root" branch -d "$branch"
  fi
}

main() {
  case ${1:-} in
    -h|--help|'') usage ;;
    help)
      shift
      [[ $# -le 1 ]] || die 'help accepts at most one command'
      command_usage "${1:-}"
      ;;
    new|branch|open|list|remove)
      local command=$1
      shift
      if [[ ${1:-} == -h || ${1:-} == --help ]]; then
        command_usage "$command"
        exit 0
      fi
      require_repo
      "cmd_$command" "$@"
      ;;
    pr)
      die 'PR review is deferred until a verified external sandbox is configured'
      ;;
    *)
      die "unknown command: $1 (run 'pwt --help')"
      ;;
  esac
}

main "$@"
