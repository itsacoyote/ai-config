#!/usr/bin/env bash
# pwt — manage this repository's git worktrees and launch Pi inside them.
#
# Pi inherits its process working directory. Every launching subcommand therefore
# enters the selected physical worktree before exec'ing the Pi executable that was
# resolved on PATH before the directory change.

set -euo pipefail

PROGRAM=${0##*/}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 2
}

note() { printf '%s: %s\n' "$PROGRAM" "$*"; }

usage() {
  cat <<'EOF'
Usage:
  pwt [list]                       list this repository's managed worktrees
  pwt new <branch> [-- <args>]     branch from the origin default, then launch
  pwt branch <branch> [-- <args>]  check out an existing branch, then launch
  pwt open <branch> [-- <args>]    launch in an existing managed worktree
  pwt pr <n> [--force] [-- <args>]  check out a pull request, then launch read-only
  pwt root [-- <args>]             launch in the primary checkout
  pwt remove <branch> [--delete-branch]
  pwt prune [--yes]                sweep worktrees whose branch has merged
  pwt install                      symlink pwt onto your PATH
  pwt help

Commands:
  new       Create an explicitly named branch from the origin default and launch.
  branch    Check out or reuse an existing local/remote branch and launch.
  open      Launch in an existing managed worktree by branch name.
  pr        Check a pull request out and launch with Pi's read-only restrictions.
  root      Launch in the primary (non-worktree) checkout.
  list      List this repository's managed worktrees.
  remove    Remove a clean managed worktree; keep its branch by default.
  prune     Remove managed worktrees whose branch has an already-merged PR.
  install   Symlink this script to ~/.local/bin/pwt.
  help      Show this usage.

Managed worktrees live in:
  ~/github/.worktrees/<owner>/<repo>/<branch-with-slashes-as-dashes>/

Arguments after `--` are passed through to `pi` unchanged.
EOF
}

# --------------------------------------------------------------- foundations

# Physically resolves a path that need not exist yet: walk up to the deepest
# existing ancestor, resolve that, then append the missing tail.
resolve_path() {
  local path=$1 tail='' base
  while [[ ! -d $path && $path == */* ]]; do
    tail="${path##*/}${tail:+/$tail}"
    path=${path%/*}
    [[ -n $path ]] || path=/
  done
  base=$(cd -P "$path" 2>/dev/null && pwd -P) || return 1
  [[ $base != / ]] || base=''
  if [[ -n $tail ]]; then
    printf '%s/%s\n' "$base" "$tail"
  else
    printf '%s\n' "${base:-/}"
  fi
}

parse_remote_identity() {
  local url=$1 rest
  url=${url%.git}
  url=${url%/}

  repo=${url##*/}
  rest=${url%/*}
  owner=${rest##*/}
  owner=${owner##*:}

  # Do not echo the remote URL here: HTTPS remotes can contain credentials.
  valid_identity_part "$owner" || die 'cannot derive owner from origin remote'
  valid_identity_part "$repo" || die 'cannot derive repository from origin remote'
}

valid_identity_part() {
  case $1 in
    '' | . | .. | *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

# Prints the physical common Git directory for a worktree.
git_common_dir() {
  local directory=$1 common
  common=$(git -C "$directory" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
    return 1
  (cd -P "$common" 2>/dev/null && pwd -P)
}

# Validates PWT_REPO_ROOT at the process boundary. When pwt is already inside a
# repository, an override must name that same repository; this catches a stale
# inherited value after a user changes into another checkout. Outside Git, a
# valid override intentionally supplies the repository discovery root.
resolve_primary() {
  local configured=${PWT_REPO_ROOT:-}
  local current_common='' configured_physical configured_top configured_common
  local configured_primary

  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    current_common=$(git_common_dir .) || die 'cannot resolve the current git common directory'
  fi

  if [[ -z $configured ]]; then
    [[ -n $current_common ]] || die 'run pwt from inside a git repository'
    primary=$(cd -P "$current_common/.." 2>/dev/null && pwd -P) ||
      die "cannot resolve the primary checkout from: $current_common"
    return 0
  fi

  case $configured in
    /*) ;;
    *) die 'PWT_REPO_ROOT must be an absolute path' ;;
  esac
  [[ -d $configured ]] || die 'PWT_REPO_ROOT must name an existing directory'

  configured_physical=$(cd -P "$configured" 2>/dev/null && pwd -P) ||
    die 'cannot resolve the PWT_REPO_ROOT directory'
  git -C "$configured_physical" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die 'PWT_REPO_ROOT must name a git repository'

  configured_top=$(git -C "$configured_physical" rev-parse --show-toplevel 2>/dev/null) ||
    die 'cannot resolve the PWT_REPO_ROOT checkout'
  configured_top=$(cd -P "$configured_top" 2>/dev/null && pwd -P) ||
    die 'cannot physically resolve the PWT_REPO_ROOT checkout'
  [[ $configured_physical == "$configured_top" ]] ||
    die 'PWT_REPO_ROOT must name the repository checkout root'

  configured_common=$(git_common_dir "$configured_physical") ||
    die 'cannot resolve the PWT_REPO_ROOT git common directory'
  configured_primary=$(cd -P "$configured_common/.." 2>/dev/null && pwd -P) ||
    die "cannot resolve the primary checkout from: $configured_common"
  [[ $configured_physical == "$configured_primary" ]] ||
    die 'PWT_REPO_ROOT must name the primary checkout, not a linked worktree'

  if [[ -n $current_common && $configured_common != "$current_common" ]]; then
    die 'PWT_REPO_ROOT must name the current repository'
  fi

  primary=$configured_physical
}

# Resolves the values every lifecycle command builds on. The primary checkout is
# physical and never the linked worktree returned by --show-toplevel.
require_repo() {
  resolve_primary

  primary_common=$(git_common_dir "$primary") ||
    die 'cannot resolve the primary git common directory'

  local remote_url
  remote_url=$(git -C "$primary" remote get-url origin 2>/dev/null) ||
    die 'repository has no origin remote'
  parse_remote_identity "$remote_url"

  managed_root=$(resolve_path "$HOME/github/.worktrees/$owner/$repo") ||
    die "cannot resolve the managed worktree root under: $HOME"
}

# --------------------------------------------------------------- launching

# Everything before `--` belongs to pwt. Unknown pwt-side flags fail loudly;
# everything after it is retained as an indexed array and handed to Pi exactly.
parse_launch_args() {
  LAUNCH_ARGS=()
  LAUNCH_POSITIONAL=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --)
        shift
        LAUNCH_ARGS=("$@")
        return 0
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*)
        die "unknown option: $1 (run 'pwt help')"
        ;;
      *)
        LAUNCH_POSITIONAL+=("$1")
        ;;
    esac
    shift
  done
}

# Resolves the selected executable to an absolute path before launch changes cwd.
# Relative PATH entries are valid shell behavior, so resolve the containing
# directory physically while it still has the caller's intended meaning.
resolve_pi() {
  local candidate directory basename
  candidate=$(command -v pi 2>/dev/null) || die 'pi not found on PATH'

  case $candidate in
    */*) ;;
    *)
      candidate=$(type -P pi 2>/dev/null) || die 'pi on PATH is not an executable file'
      ;;
  esac

  directory=${candidate%/*}
  basename=${candidate##*/}
  [[ $directory != "$candidate" ]] || directory=.
  directory=$(cd -P "$directory" 2>/dev/null && pwd -P) ||
    die 'cannot resolve the pi executable directory'
  pi_command="$directory/$basename"
  [[ -f $pi_command && -x $pi_command ]] || die 'pi on PATH is not an executable file'
}

launch() {
  local target=$1
  resolve_pi

  cd -P "$target" || die "cannot enter directory: $target"
  export PWT_REPO_ROOT="$primary"

  note "launching pi in $target"
  if ((${#LAUNCH_ARGS[@]})); then
    exec "$pi_command" "${LAUNCH_ARGS[@]}"
  fi
  exec "$pi_command"
}

# ------------------------------------------------------------------- commands

validate_branch() {
  git -C "$primary" check-ref-format --branch "$1" >/dev/null 2>&1 ||
    die "invalid branch name: $1"
}

# Prints the path of the worktree holding a local branch, if any. Porcelain
# output keeps paths and branch names unambiguous without depending on columns.
branch_worktree() {
  local wanted=$1 line path='' records
  records=$(git -C "$primary" worktree list --porcelain) || return 2
  while IFS= read -r line; do
    case $line in
      'worktree '*)
        path=${line#worktree }
        ;;
      "branch refs/heads/$wanted")
        printf '%s\n' "$path"
        return 0
        ;;
    esac
  done <<< "$records"
  return 1
}

# A registered path is not automatically pwt-owned. Refuse symlinks and require
# the physical directory to remain below the physical shared managed root.
require_managed_worktree() {
  local branch=$1 path=$2 physical common actual_branch
  [[ ! -L $path ]] || die "managed worktree path must not be a symlink: $path"
  physical=$(cd -P "$path" 2>/dev/null && pwd -P) ||
    die "cannot resolve worktree directory: $path"
  case $physical in
    "$managed_root"/*) ;;
    *) die "worktree is not under the managed root, so pwt does not manage it: $path" ;;
  esac

  common=$(git_common_dir "$physical") ||
    die "registered worktree path is not a git worktree: $path"
  [[ $common == "$primary_common" ]] ||
    die "registered worktree belongs to a different repository: $path"
  actual_branch=$(git -C "$physical" symbolic-ref --quiet --short HEAD 2>/dev/null) ||
    die "registered worktree is not on the expected branch: $branch"
  [[ $actual_branch == "$branch" ]] ||
    die "registered worktree is on $actual_branch, not the expected branch: $branch"
}

require_reusable_worktree() {
  local branch=$1 existing=$2
  if [[ $existing == "$primary" ]]; then
    die "$branch is checked out in the primary checkout ($primary); use 'pwt root' to work there"
  fi

  case $existing in
    "$managed_root"/*) ;;
    *) die "$branch is checked out at $existing, which pwt does not manage" ;;
  esac
  require_managed_worktree "$branch" "$existing"
}

reuse_or_refuse() {
  local branch=$1 existing=$2
  require_reusable_worktree "$branch" "$existing"
  note "reusing existing worktree for $branch"
  launch "$existing"
}

# Query the remote rather than cached origin/HEAD, which can remain stale after
# a repository changes its default branch.
default_remote_branch() {
  local ref
  if ! ref=$(git -C "$primary" ls-remote --symref origin HEAD 2>/dev/null |
    sed -n 's|^ref: refs/heads/\([^[:space:]]*\).*|\1|p' | head -1); then
    die 'cannot determine the current origin default branch'
  fi
  [[ -n $ref ]] || die 'cannot determine the current origin default branch'
  printf '%s\n' "$ref"
}

local_branch_exists() {
  local branch=$1 status
  if git -C "$primary" show-ref --verify --quiet "refs/heads/$branch"; then
    return 0
  else
    status=$?
  fi
  ((status == 1)) && return 1
  return 2
}

worktree_name_for_branch() {
  printf '%s\n' "${1//\//-}"
}

# check-ref-format protects Git's ref namespace; this second allowlist protects
# the filesystem path segment derived from that ref.
validate_worktree_name() {
  case $1 in
    '' | . | .. | *..* | */* | *[!A-Za-z0-9._-]*)
      die "branch name does not produce a safe directory name: $1"
      ;;
  esac
}

registered_at() {
  local wanted=$1 line records
  records=$(git -C "$primary" worktree list --porcelain) || return 2
  while IFS= read -r line; do
    if [[ $line == "worktree $wanted" ]]; then
      return 0
    fi
  done <<< "$records"
  return 1
}

ensure_available_path() {
  local path=$1 status
  [[ ! -L $path ]] || die "target path must not be a symlink: $path"
  if registered_at "$path"; then
    die "target path is already registered for another branch: $path"
  else
    status=$?
  fi
  ((status == 1)) || die 'cannot list repository worktrees'
  [[ ! -e $path ]] ||
    die "target path exists but is not a registered worktree: $path"
}

worktree_path_is_managed() {
  local path=$1 physical
  [[ ! -L $path ]] || return 1
  physical=$(cd -P "$path" 2>/dev/null && pwd -P) || return 1
  case $physical in
    "$managed_root"/*) return 0 ;;
  esac
  return 1
}

cmd_root() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 0)) || die 'root takes no arguments'
  launch "$primary"
}

cmd_new() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'new requires exactly one branch name'

  local branch=${LAUNCH_POSITIONAL[0]} existing base name target status
  validate_branch "$branch"
  [[ $branch == */* ]] ||
    die "new needs a typed branch name such as feat/account-recovery or fix/login-timeout"

  if existing=$(branch_worktree "$branch"); then
    reuse_or_refuse "$branch" "$existing"
  else
    status=$?
    ((status == 1)) || die 'cannot list repository worktrees'
  fi
  if local_branch_exists "$branch"; then
    die "local branch already exists but is not checked out: $branch (use 'pwt branch $branch')"
  else
    status=$?
    ((status == 1)) || die "cannot inspect local branch: $branch"
  fi

  name=$(worktree_name_for_branch "$branch")
  validate_worktree_name "$name"
  target="$managed_root/$name"
  ensure_available_path "$target"

  base=$(default_remote_branch)
  note "fetching origin/$base"
  git -C "$primary" fetch --quiet origin \
    "refs/heads/$base:refs/remotes/origin/$base" ||
    die "could not fetch origin/$base"

  mkdir -p "$managed_root"
  # Fetch is an external command and can run hooks. Re-check immediately before
  # Git writes so a substituted path is refused instead of followed.
  ensure_available_path "$target"
  git -C "$primary" worktree add -b "$branch" "$target" "origin/$base"
  require_managed_worktree "$branch" "$target"
  launch "$target"
}

cmd_branch() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'branch requires exactly one branch name'

  local branch=${LAUNCH_POSITIONAL[0]} existing name target status
  validate_branch "$branch"

  if existing=$(branch_worktree "$branch"); then
    reuse_or_refuse "$branch" "$existing"
  else
    status=$?
    ((status == 1)) || die 'cannot list repository worktrees'
  fi

  name=$(worktree_name_for_branch "$branch")
  validate_worktree_name "$name"
  target="$managed_root/$name"
  ensure_available_path "$target"
  mkdir -p "$managed_root"

  if local_branch_exists "$branch"; then
    ensure_available_path "$target"
    git -C "$primary" worktree add "$target" "$branch"
  else
    status=$?
    ((status == 1)) || die "cannot inspect local branch: $branch"
    note "fetching origin/$branch"
    git -C "$primary" fetch --quiet origin \
      "refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null ||
      die "no such branch locally or on origin: $branch"
    # Fetch is an external command and can run hooks. Re-check immediately before
    # Git writes so a substituted path is refused instead of followed.
    ensure_available_path "$target"
    git -C "$primary" worktree add -b "$branch" "$target" "origin/$branch"
  fi

  require_managed_worktree "$branch" "$target"
  launch "$target"
}

cmd_open() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'open requires exactly one branch name'

  local branch=${LAUNCH_POSITIONAL[0]} target status
  validate_branch "$branch"
  if target=$(branch_worktree "$branch"); then
    :
  else
    status=$?
    ((status == 1)) && die "no worktree checked out for branch: $branch"
    die 'cannot list repository worktrees'
  fi
  require_managed_worktree "$branch" "$target"
  launch "$target"
}

cmd_list() {
  [[ $# -eq 0 ]] || die 'list takes no arguments'

  local line path='' branch='' width=0 records
  local -a listed_branches=() listed_paths=() listed_marks=()

  records=$(git -C "$primary" worktree list --porcelain) ||
    die 'cannot list repository worktrees'
  records+=$'\n'

  while IFS= read -r line; do
    case $line in
      'worktree '*)
        path=${line#worktree }
        branch='(detached)'
        ;;
      'branch refs/heads/'*)
        branch=${line#branch refs/heads/}
        ;;
      '')
        if [[ -n $path && $path != "$primary" ]]; then
          listed_branches+=("$branch")
          listed_paths+=("$path")
          if worktree_path_is_managed "$path"; then
            listed_marks+=('')
          else
            listed_marks+=('(unmanaged)')
          fi
          if ((${#branch} > width)); then width=${#branch}; fi
        fi
        path=''
        ;;
    esac
  done <<< "$records"

  if ((${#listed_branches[@]} == 0)); then
    printf 'No managed worktrees for %s/%s.\n' "$owner" "$repo"
    return 0
  fi

  local i
  for i in "${!listed_branches[@]}"; do
    if [[ -n ${listed_marks[i]} ]]; then
      printf '%-*s  %s  %s\n' "$width" "${listed_branches[i]}" \
        "${listed_paths[i]}" "${listed_marks[i]}"
    else
      printf '%-*s  %s\n' "$width" "${listed_branches[i]}" "${listed_paths[i]}"
    fi
  done
}

# Undocumented diagnostic seam for the self-contained suite.
cmd_debug_roots() {
  printf 'owner=%s\n' "$owner"
  printf 'repo=%s\n' "$repo"
  printf 'primary=%s\n' "$primary"
  printf 'managed_root=%s\n' "$managed_root"
}

main() {
  local command=${1:-list}
  case $command in
    -h | --help | help)
      usage
      ;;
    debug-roots)
      require_repo
      cmd_debug_roots
      ;;
    root)
      shift || true
      require_repo
      cmd_root "$@"
      ;;
    list | open | new | branch)
      shift || true
      require_repo
      "cmd_$command" "$@"
      ;;
    pr | remove | prune | install)
      die "$command is not implemented yet"
      ;;
    *)
      die "unknown command: $command (run 'pwt help')"
      ;;
  esac
}

main "$@"
