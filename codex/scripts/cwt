#!/usr/bin/env bash
# cwt — manage this repository's git worktrees and launch Codex inside them.
#
# Codex offers `-C` / `--cd`, but cwt deliberately changes the process working
# directory before exec'ing `codex`. The launched process and everything it starts
# inherit the target as their real cwd, which makes `git -C` unnecessary.
#
# Launching subcommands are developer-run: invoking one from an active Codex session
# would start a nested session, not move the current one into another worktree.

set -euo pipefail

PROGRAM=${0##*/}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 2
}

note() { printf '%s: %s\n' "$PROGRAM" "$*"; }
warn() { printf '%s: warning: %s\n' "$PROGRAM" "$*" >&2; }

# copy_worktree_includes can bail mid-loop; this is how its scratch file gets
# cleaned up regardless of which exit path is taken.
CWT_LIST_FILE=''
CWT_PR_FETCH_WORKTREE=''
CWT_PR_CONTEXT_TMP=''
CWT_PR_CHECKS_ERR_FILE=''
cleanup_on_exit() {
  rm -f "${CWT_LIST_FILE:-}" "${CWT_PR_CONTEXT_TMP:-}" "${CWT_PR_CHECKS_ERR_FILE:-}"
  if [[ -n ${CWT_PR_FETCH_WORKTREE:-} ]]; then
    git worktree remove --force "$CWT_PR_FETCH_WORKTREE" >/dev/null 2>&1 || true
    rmdir "$CWT_PR_FETCH_WORKTREE" >/dev/null 2>&1 || true
  fi
}
trap cleanup_on_exit EXIT

usage() {
  cat <<'EOF'
Usage:
  cwt [list]                       list this repository's managed worktrees
  cwt new <branch> [-- <args>]     branch from the origin default, then launch
  cwt branch <branch> [-- <args>]  check out an existing branch, then launch
  cwt open <branch> [-- <args>]    launch in an existing managed worktree
  cwt pr <n> [--force] [--no-review] [-- <args>]
                                    check out a pull request, then launch
  cwt root [-- <args>]             launch in the primary checkout
  cwt remove <branch> [--delete-branch]
                                    --delete-branch also deletes a squash-merged
                                    branch when GitHub shows its merged PR at the
                                    same commit (needs gh)
  cwt prune [--yes]                sweep worktrees whose branch has merged
  cwt install                      symlink cwt onto your PATH
  cwt help

Commands:
  new       Create an explicitly named branch from the origin default and launch.
  branch    Check out or reuse an existing local/remote branch and launch.
  open      Launch in an existing managed worktree by branch name.
  pr        Check a pull request out into a managed worktree and launch.
  root      Launch in the primary (non-worktree) checkout.
  list      List this repository's managed worktrees.
  remove    Remove a clean managed worktree; keep its branch by default.
            --delete-branch deletes it if merged, or squash-merged per GitHub (gh).
  prune     Remove managed worktrees whose branch has an already-merged PR.
  install   Symlink this script to ~/.local/bin/cwt.
  help      Show this usage.

Managed worktrees live in:
  ~/github/.worktrees/<owner>/<repo>/<branch-with-slashes-as-dashes>/

`--yolo` on a launching subcommand passes Codex's native --yolo flag, which
bypasses approvals and sandboxing for that session.

`--force` on `cwt pr` passes --force to `gh pr checkout`, resetting a leftover
local branch to the pull request head. An existing managed PR worktree is
refreshed only after cwt verifies its PR identity and its clean local state;
`--force` does not bypass those reuse guards.
Without the flag, `cwt pr` resets a leftover branch on its own only when the
branch is provably contained in `origin/<branch>` (no local-only commits);
otherwise the checkout runs plain, and if it then fails, the error names this
flag.

`cwt pr` always fetches the pull request's review context into
`pr-context.md`, in a session folder alongside the worktree (not inside it);
unless `--no-review`, it also sends a one-line startup prompt telling codex
to review that file. `cwt remove`/`cwt prune` delete the file with the
worktree. `--no-review` skips the prompt but still writes the file; a
context-fetch failure then only warns instead of refusing to launch. A symlink, containment, or mkdir refusal on the
session folder itself stays fatal either way — that signals tampering, not a
transient fetch failure.

`cwt pr` also withholds the prompt (and warns instead) when the pull
request's own checked-out diff touches a path under `.agents` or `.codex`
relative to its merge base with the base branch: unlike Claude, Codex does
not rank a personal skill above a project one on a name collision, so a pull
request shipping `.agents/skills/pr-review` could otherwise replace the
review the prompt is about to start. It still launches either way.
Unless `--no-review`, `cwt pr` first fetches the pull request's base branch
from origin; if that fetch fails, it withholds the prompt and warns.
When the review is withheld for any reason and stdin and stderr are both
terminals, `cwt pr` waits for Enter before launching (Ctrl-D continues,
Ctrl-C cancels).

It also withholds the prompt when the PR's checked-out `.agents`/`.codex` tree is
unchanged from its own merge base but has since diverged from the base branch's current
tip, naming the real base branch and telling you to rebase to get the prompt back.

Arguments after `--` are passed through to `codex`.
EOF
}

# --------------------------------------------------------------- foundations

# Physically resolves a path that need not exist yet: walk up to the deepest
# existing ancestor, resolve that, re-append the missing tail.
#
# Resolving only $HOME is not enough. `git worktree list` reports fully resolved
# paths, so if ~/github or ~/github/.worktrees is itself a symlink — relocating
# worktrees to a bigger volume is an ordinary thing to do — every containment
# check compares a resolved path against a partly-unresolved prefix, and cwt
# disowns the worktrees it just created.
resolve_path() {
  local path=$1 tail='' base
  while [[ ! -d $path && $path == */* ]]; do
    tail="${path##*/}${tail:+/$tail}"
    path=${path%/*}
    [[ -n $path ]] || path=/
  done
  base=$(cd -P "$path" 2>/dev/null && pwd -P) || return 1
  # When the walk reaches the filesystem root, `$base/` would double the
  # separator, and a `//prefix` managed root fails its own containment check —
  # the disown-your-own-worktree bug wearing a different hat.
  [[ $base != / ]] || base=''
  if [[ -n $tail ]]; then
    printf '%s/%s\n' "$base" "$tail"
  else
    printf '%s\n' "${base:-/}"
  fi
}

# Resolves, once, the four values every other subcommand builds on:
#   owner, repo         — from the origin remote
#   primary             — the primary (non-worktree) checkout
#   managed_root        — ~/github/.worktrees/<owner>/<repo>
#
# `primary` deserves a note. It is NOT `git rev-parse --show-toplevel`, which
# returns the *worktree* when cwt runs inside one — the common case here. Nor is
# it `--git-common-dir`, which returns the `.git` directory itself. It is the
# checkout containing that git dir, which is where .worktreeinclude lives, where
# the copy sources from, and what CWT_REPO_ROOT must point at so a tracker can
# find its one central database.
require_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die 'run cwt from inside a git repository'

  local remote_url
  remote_url=$(git remote get-url origin 2>/dev/null) ||
    die 'repository has no origin remote'

  parse_remote_identity "$remote_url"

  local common_dir
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
    die 'cannot resolve the git common directory'
  # Physically resolved, not just the raw path git-common-dir returns: the pr
  # session folder lives under here, and every path it is later compared
  # against (in the symlink/containment guards) is `pwd -P`'d too.
  primary_common=$(cd -P "$common_dir" 2>/dev/null && pwd -P) ||
    die "cannot resolve the git common directory: $common_dir"
  primary=$(cd "$common_dir/.." 2>/dev/null && pwd -P) ||
    die "cannot resolve the primary checkout from: $common_dir"

  # Fully resolved, because every path this is later compared against is `pwd -P`'d.
  # Against an unresolved prefix cwt would create a worktree and then immediately
  # disown it: `list` marks it unmanaged, `open` and `remove` refuse it, and
  # `branch` reports it as checked out somewhere cwt does not manage — its own
  # worktree.
  managed_root=$(resolve_path "$HOME/github/.worktrees/$owner/$repo") ||
    die "cannot resolve the managed worktree root under: $HOME"
}

# Splits owner/repo out of any remote URL shape we care about, in pure shell:
#   git@host:owner/repo.git      https://host/owner/repo.git
#   ssh://git@host/owner/repo    /local/path/owner/repo.git
# In every one of those the last two path segments are owner and repo, so strip
# the .git suffix and take them from the end.
parse_remote_identity() {
  local url=$1 rest
  url=${url%.git}
  url=${url%/}

  repo=${url##*/}
  rest=${url%/*}
  owner=${rest##*/}
  owner=${owner##*:} # git@host:owner -> owner

  # Do not echo the remote URL here: HTTPS remotes can contain credentials.
  valid_identity_part "$owner" || die 'cannot derive owner from origin remote'
  valid_identity_part "$repo" || die 'cannot derive repository from origin remote'
}

valid_identity_part() {
  local LC_ALL=C
  case $1 in
    '' | . | .. | *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

# --------------------------------------------------------------- launching

# Splits a launching subcommand's arguments into three parts:
#   LAUNCH_POSITIONAL — the subcommand's own operands (a branch, a PR number)
#   LAUNCH_YOLO       — 1 when --yolo was given
#   LAUNCH_ARGS       — everything after `--` (pr may append the review prompt after it),
#                       handed to codex untouched
#
# Everything before `--` belongs to cwt. An unrecognized cwt-side flag is an
# error rather than being forwarded, so a typo like `--yolol` fails loudly
# instead of silently reaching codex as an unknown argument.
parse_launch_args() {
  LAUNCH_YOLO=0
  LAUNCH_ARGS=()
  LAUNCH_POSITIONAL=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --)
        shift
        LAUNCH_ARGS=("$@")
        return 0
        ;;
      --yolo)
        LAUNCH_YOLO=1
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*)
        die "unknown option: $1 (run 'cwt help')"
        ;;
      *)
        LAUNCH_POSITIONAL+=("$1")
        ;;
    esac
    shift
  done
}

# Set by finish_pr_context when a requested review was not started. Initialized
# here because launch() reads it for every subcommand, under `set -u`.
PR_REVIEW_SKIPPED=0

# The codex session UI hides everything printed before it starts, so a skip
# warning is unreadable unless the launch waits. Both streams must be terminals
# so a redirected stderr never waits on an invisible prompt.
pause_for_skipped_review() {
  ((PR_REVIEW_SKIPPED)) && [[ -t 0 && -t 2 ]] || return 0
  printf '%s: press Enter to open the session without the review (Ctrl-C to cancel)... ' "$PROGRAM" >&2
  read -r _ || printf '\n' >&2
}

# The whole point of the tool: make the operating-system process cwd correct by
# construction. Codex has a `-C` flag, but cd plus exec also roots startup hooks
# and child processes in the target before Codex parses any arguments.
#
# CWT_REPO_ROOT rides along so any issue tracker in that session can find the
# one central database in the primary checkout. `bd` resolves it through the git
# common dir on its own; this is the tool-agnostic form of the same guarantee.
launch() {
  local target=$1
  local -a argv=()

  command -v codex >/dev/null 2>&1 || die 'codex not found on PATH'

  pause_for_skipped_review

  if ((LAUNCH_YOLO)); then
    argv+=(--yolo)
  fi
  if ((${#LAUNCH_ARGS[@]})); then
    argv+=("${LAUNCH_ARGS[@]}")
  fi

  cd -P "$target" || die "cannot enter directory: $target"
  export CWT_REPO_ROOT="$primary"

  note "launching codex in $target"
  if ((${#argv[@]})); then
    exec codex "${argv[@]}"
  fi
  exec codex
}

# ------------------------------------------------------------------- commands

validate_branch() {
  git check-ref-format --branch "$1" >/dev/null 2>&1 || die "invalid branch name: $1"
}

# Path of the worktree holding <branch>, if any. Prints nothing and returns 1
# when the branch is not checked out anywhere.
branch_worktree() {
  local wanted=$1 line path=''
  while IFS= read -r line; do
    case $line in
      'worktree '*)
        path=${line#worktree }
        ;;
      "branch refs/heads/$wanted")
        printf '%s\n' "$path"
        return 0
        ;;
    esac
  done < <(git worktree list --porcelain)
  return 1
}

# True iff <branch>'s local tip is provably contained in (equal to, or an
# ancestor of) refs/remotes/origin/<branch> AT THIS MOMENT — i.e. resetting the
# local branch to that tip would discard nothing. Fully-qualified refs only:
# head_ref is fork-controlled input, and an unqualified name could resolve to a
# tag or some other ref outside refs/heads / refs/remotes/origin entirely.
#
# Every check sits in its own `if`, never chained straight into merge-base:
# the script runs set -euo pipefail, and the ref this guards against missing —
# a branch cwt has never fetched — is the COMMON case here, not a corner one.
# The existence guard doubles as what keeps git's own "Not a valid object
# name" fatal off stderr on that common path, by never handing merge-base a
# ref that isn't there.
branch_contained_in_origin() {
  local branch=$1
  if ! git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    return 1
  fi
  # Fail closed: an ancestor match returns 0 (safe). Anything else — not an
  # ancestor (exit 1) or a broken repository state (exit >1) — returns 1
  # (not safe). A merge-base error must never read as "safe to reset".
  if git merge-base --is-ancestor "refs/heads/$branch" "refs/remotes/origin/$branch"; then
    return 0
  fi
  return 1
}

# Refuses anything cwt did not put where it expects. The symlink check comes
# first and is not redundant: without it, a symlink sitting inside the managed
# root could point anywhere, and the containment check below — which compares the
# *resolved* path — would be satisfied by a directory cwt never created.
require_managed_worktree() {
  local path=$1 physical
  [[ ! -L $path ]] || die "managed worktree path must not be a symlink: $path"
  physical=$(cd -P "$path" 2>/dev/null && pwd -P) ||
    die "cannot resolve worktree directory: $path"
  case $physical in
    "$managed_root"/*) ;;
    *) die "worktree is not under the managed root, so cwt does not manage it: $path" ;;
  esac
}

# Prefix assignment, never `export`: export would survive `exec codex` and
# land these options on every later push in that session. Base follows git's
# own ssh precedence; options are appended, so a custom command must accept OpenSSH -o.
remote_git() {
  local base
  if [[ -n ${GIT_SSH_COMMAND:-} ]]; then
    base=$GIT_SSH_COMMAND
  elif base=$(git config --get core.sshCommand 2>/dev/null); then
    :
  elif [[ -n ${GIT_SSH:-} ]]; then
    base=$(printf '%q' "$GIT_SSH")
  else
    base=ssh
  fi
  GIT_SSH_COMMAND="$base -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2" \
    git "$@"
}

# Asks the remote what its default branch is *now*. Deliberately not
# origin/HEAD, which is cached at clone time and goes stale the moment the
# repository's default branch changes — branching from a stale default is a
# quiet way to build on the wrong base.
default_remote_branch() {
  local ref
  if ! ref=$(remote_git ls-remote --symref origin HEAD |
    sed -n 's|^ref: refs/heads/\([^[:space:]]*\).*|\1|p' | head -1); then
    die 'cannot determine the current origin default branch'
  fi
  [[ -n $ref ]] || die 'cannot determine the current origin default branch'
  printf '%s\n' "$ref"
}

worktree_name_for_branch() {
  printf '%s\n' "${1//\//-}"
}

# The branch name has already passed check-ref-format, but it is about to become
# a directory name, so it gets a second, narrower check against the character set
# actually safe in a path segment.
validate_worktree_name() {
  case $1 in
    '' | . | .. | *..* | */* | *[!A-Za-z0-9._-]*)
      die "branch name does not produce a safe directory name: $1"
      ;;
  esac
}

registered_at() {
  local wanted=$1 line
  while IFS= read -r line; do
    if [[ $line == "worktree $wanted" ]]; then
      return 0
    fi
  done < <(git worktree list --porcelain)
  return 1
}

# A stale directory squatting on the target path makes `git worktree add` fail
# with a message about the path being unusable, which sends you looking in the
# wrong place. Catch it here and say what is actually wrong.
ensure_available_path() {
  local path=$1
  [[ ! -L $path ]] || die "target path must not be a symlink: $path"
  if [[ -e $path ]]; then
    registered_at "$path" ||
      die "target path exists but is not a registered worktree: $path"
  fi
}

# Copies the untracked files a fresh worktree needs to actually run the project —
# .env and friends — preserving the established .worktreeinclude behavior.
#
# Two things here are load-bearing:
#
# 1. Both the pattern file and the copy source come from the PRIMARY checkout.
#    `--exclude-from` resolves relative to the current directory, and cwt is
#    routinely run from inside a worktree, where neither would be found.
#
# 2. .beads/ is refused unconditionally, even when the patterns match it.
#    `git ls-files --others --ignored --exclude-from` does return gitignored
#    paths, so a `.beads/` entry here would be copied — giving the worktree its
#    own forked issue database whose writes diverge and are lost. That is exactly
#    the regression PR #48 fixed by removing the pattern; this refuses to
#    reintroduce it no matter what the pattern file says. Worktrees share the
#    primary checkout's single database through the git common dir.
# Removes a worktree that was created but could not be finished, so a retry does
# not trip over a path that exists and holds nothing useful — and, worse, so the
# next `cwt branch <same>` does not silently *reuse* a worktree that is missing
# the .env this function exists to provide.
abandon_worktree() {
  git worktree remove --force "$1" 2>/dev/null || true
}

copy_worktree_includes() {
  local target=$1
  local pattern_file="$primary/.worktreeinclude"
  [[ -f $pattern_file ]] || return 0

  # The list goes through a temp file rather than a variable: NUL-delimited output
  # cannot round-trip through $( ), which strips null bytes, and NUL-delimiting is
  # what keeps filenames containing spaces or newlines intact. A file also lets us
  # check git's exit status, so a failure is not read as "nothing matched".
  # Every failure below RETURNS rather than dies. Being called as `copy … || {…}`
  # disables errexit for this whole body, so each fallible step is checked by hand;
  # and a `die` here would exit cwt outright, so the caller's cleanup handler
  # would never run.
  # Templated, not bare: BSD/macOS `mktemp` requires a template or -t, so a bare
  # call is a usage error there — which would break every worktree-creating
  # command on macOS in any repo that has a .worktreeinclude. Same reason this
  # script hand-rolls symlink resolution instead of using GNU `readlink -f`.
  local list_file
  list_file=$(mktemp "${TMPDIR:-/tmp}/cwt.XXXXXX") || {
    warn 'cannot create a temporary file'
    return 1
  }
  CWT_LIST_FILE=$list_file

  if ! (cd "$primary" &&
    git ls-files --others --ignored --exclude-from="$pattern_file" -z) >"$list_file"; then
    warn 'cannot list .worktreeinclude matches'
    return 1
  fi

  local resolved_target
  resolved_target=$(cd -P "$target" 2>/dev/null && pwd -P) || {
    warn "cannot resolve the worktree directory: $target"
    return 1
  }

  local rel src dst dst_dir resolved_dir copied=0 refused_beads=0
  while IFS= read -r -d '' rel; do
    case $rel in
      .beads | .beads/*)
        refused_beads=1
        continue
        ;;
    esac

    # Assertion, not a defense against a known vector: `git ls-files` emits
    # normalized repo-relative paths, so neither case should ever fire. It is
    # here because $rel is about to become a path we write to, and an invariant
    # that cheap is worth stating out loud rather than assuming.
    case $rel in
      /* | *..*)
        warn "refusing to copy a path that escapes the worktree: $rel"
        return 1
        ;;
    esac

    src="$primary/$rel"
    [[ -f $src ]] || continue
    dst="$target/$rel"

    # The destination is inside a tree whose *contents* came from a branch, which
    # on a fork PR means from someone else. A hostile branch can commit the
    # matched path as a tracked symlink pointing anywhere — git materializes it,
    # and `cp` then writes THROUGH it, straight out of the managed root. (cp's
    # -P/--no-dereference does not help; those govern the source.) Verified
    # writing to ~/.bashrc this way before the guard existed.
    if [[ -L $dst ]]; then
      warn "refusing to copy onto a symlink inside the worktree: $rel"
      return 1
    fi

    # A directory at the destination is the third shape, and it slips past both
    # the symlink check above and the parent-containment check below: given an
    # existing directory, `cp` copies *into* it as $dst/$(basename $src) — and
    # src and dst share a basename here, so a branch that commits `.env/` as a
    # directory holding a symlink named `.env` lands the write on that symlink.
    # Verified escaping to an arbitrary absolute path. Git can only materialise
    # regular files, symlinks, directories, and gitlinks (directories too), so
    # "nonexistent or a regular file" is the complete allowlist. Order matters:
    # -L must be tested first, because -f follows symlinks. `cp -pT` would also
    # fix it but -T is GNU-only, which the mktemp comment above exists to avoid.
    if [[ -e $dst && ! -f $dst ]]; then
      warn "refusing to copy onto a non-regular destination inside the worktree: $rel"
      return 1
    fi

    # Validate the parent BEFORE creating it. `mkdir -p` follows a committed
    # symlink at an intermediate component and creates the missing tail on the far
    # side, so checking afterwards still hands a hostile branch an
    # arbitrary-empty-directory primitive anywhere the developer can write.
    # resolve_path exists precisely to resolve a path that need not exist yet.
    dst_dir=${dst%/*}
    resolved_dir=$(resolve_path "$dst_dir") || {
      warn "cannot resolve the destination directory for $rel"
      return 1
    }
    case "$resolved_dir/" in
      "$resolved_target"/*) ;;
      *)
        warn "refusing to copy $rel — its destination resolves outside the worktree"
        return 1
        ;;
    esac

    mkdir -p "$dst_dir" || {
      warn "cannot create the directory for $rel"
      return 1
    }

    # Re-check after creating: an ancestor could have been created earlier in this
    # same loop, and the pre-check only saw the state before that.
    resolved_dir=$(cd -P "$dst_dir" 2>/dev/null && pwd -P) || {
      warn "cannot resolve the destination directory for $rel"
      return 1
    }
    case "$resolved_dir/" in
      "$resolved_target"/*) ;;
      *)
        warn "refusing to copy $rel — its destination resolves outside the worktree"
        return 1
        ;;
    esac

    cp -p "$src" "$dst" || {
      warn "cannot copy $rel into the worktree"
      return 1
    }
    copied=$((copied + 1))
  done <"$list_file"
  rm -f "$list_file"
  CWT_LIST_FILE=''

  if ((refused_beads)); then
    warn "refusing to copy .beads/ — worktrees share the primary checkout's single issue database, and copying it forks them (see PR #48)"
  fi
  # Reported unconditionally: "copied 0" and a silent return would otherwise be
  # indistinguishable from the copy never having run.
  note "copied $copied file(s) matching .worktreeinclude"
}

# Applies the location guards shared by generic reuse and pull-request refresh.
# It deliberately does not launch or mutate anything: callers still have work
# to do after the target has been proven to be one cwt owns.
require_reusable_worktree() {
  local branch=$1 existing=$2
  if [[ $existing == "$primary" ]]; then
    die "$branch is checked out in the primary checkout ($primary); use 'cwt root' to work there"
  fi

  case $existing in
    "$managed_root"/*) ;;
    *) die "$branch is checked out at $existing, which cwt does not manage" ;;
  esac

  require_managed_worktree "$existing"
}

# Git allows a branch in exactly one worktree, so "it is already checked out" has
# three quite different meanings and three different right answers. Git's own
# message names none of them usefully, which leaves you hunting for where the
# branch actually is.
reuse_or_refuse() {
  local branch=$1 existing=$2 force=${3:-0}

  require_reusable_worktree "$branch" "$existing"
  # --force resets a branch cwt is about to check out fresh; once it is already
  # sitting in a managed worktree there is nothing to reset, so say so rather
  # than silently swallowing the flag.
  if ((force)); then
    note "not resetting $branch — it is already checked out at $existing"
  fi
  note "reusing existing worktree for $branch"
  launch "$existing"
}

# "Dirty" deliberately means `--untracked-files=all` WITHOUT `--ignored`, and
# neither obvious alternative works:
#
#   plain --porcelain     a worktree holding a .worktreeinclude-copied .env reads
#                         as clean (the project's .gitignore covers it), so
#                         removal would silently destroy it
#   ... --ignored         every worktree cwt creates reads as dirty, so removal
#                         would always refuse
#
# So: genuine uncommitted or untracked work blocks removal, and ignored files do
# not — but since `git worktree remove` deletes them without comment, they get
# named first. The report is the only thing standing between you and a lost .env.
# Both capture git's exit status explicitly. `set -e` does not help: errexit is
# disabled inside command substitution `$( )`, which is exactly why `rc=$?` is
# reachable here at all. Without the check, a git failure — index lock
# contention, a partially-pruned gitdir, a permission problem — yields empty
# output, which reads as "clean" and as "nothing will be destroyed". Both
# mistakes delete things.
#
# Note for future callers: these must be invoked from a command-substitution or
# an `if` condition. A process substitution `< <(...)` would NOT work — unlike
# `$( )`, it inherits errexit, so the assignment aborts the subshell before the
# status check runs, and a `die` there would only exit the subshell while the
# parent carried on deleting. That was a real bug here, not a hypothetical.
worktree_is_dirty() {
  local path=$1 action=${2:-remove} out rc
  out=$(cd "$path" && git status --porcelain --untracked-files=all)
  rc=$?
  ((rc == 0)) ||
    die "cannot determine whether $path is clean (git exited $rc); refusing to $action"
  [[ -n $out ]]
}

worktree_ignored_files() {
  local out rc
  out=$(cd "$1" && git ls-files --others --ignored --exclude-standard)
  rc=$?
  ((rc == 0)) || return 1
  printf '%s' "$out"
}

valid_head_oid() {
  local oid=$1
  case $oid in
    '' | *[!0-9A-Fa-f]*) return 1 ;;
  esac
  [[ ${#oid} == 40 || ${#oid} == 64 ]]
}

# gh's `.author.login` returns a bot PR's author as `app/<name>` (e.g.
# `app/dependabot`), not a bare login — https://github.com/cli/cli/pull/14543.
valid_pr_author() {
  local LC_ALL=C
  [[ $1 =~ ^(app/)?[A-Za-z0-9_-]+(\[bot\])?$ ]]
}

remote_matches_identity() {
  local remote=$1 wanted_owner=$2 wanted_repo=$3 url rest found_owner found_repo
  if ! url=$(git remote get-url "$remote" 2>/dev/null); then
    url=$remote
  fi
  url=${url%.git}
  url=${url%/}
  found_repo=${url##*/}
  rest=${url%/*}
  found_owner=${rest##*/}
  found_owner=${found_owner##*:}
  valid_identity_part "$found_owner" || return 1
  valid_identity_part "$found_repo" || return 1
  [[ $(printf '%s' "$found_owner" | tr '[:upper:]' '[:lower:]') == "$wanted_owner" ]] &&
    [[ $(printf '%s' "$found_repo" | tr '[:upper:]' '[:lower:]') == "$wanted_repo" ]]
}

# Parses a canonical PR URL — anchored on a literal https:// prefix, since
# gh's own `.url` field is always that, never another scheme or a bare
# host:path clone form — into PR_HOST/PR_BASE_OWNER/PR_BASE_REPO. Shared by
# the reuse-safety identity check and by write_pr_context's gh api calls, so
# both apply the exact same parse rules to the exact same field.
pr_url_identity() {
  local url=$1 number=$2 rest host path
  case $url in
    https://*/pull/"$number") ;;
    *) return 1 ;;
  esac
  rest=${url#https://}
  host=${rest%%/*}
  path=${rest#*/}
  path=${path%/pull/$number}
  PR_BASE_REPO=${path##*/}
  PR_BASE_OWNER=${path%/*}
  valid_host "$host" || return 1
  valid_identity_part "$PR_BASE_OWNER" || return 1
  valid_identity_part "$PR_BASE_REPO" || return 1
  PR_HOST=$host
  PR_BASE_OWNER=$(printf '%s' "$PR_BASE_OWNER" | tr '[:upper:]' '[:lower:]')
  PR_BASE_REPO=$(printf '%s' "$PR_BASE_REPO" | tr '[:upper:]' '[:lower:]')
}

branch_tracks_pr_head() {
  local branch=$1 number=$2 pr_url=$3 head_ref=$4 head_owner=$5 head_repo=$6
  local remote merge
  remote=$(git config --get "branch.$branch.remote" 2>/dev/null) || return 1
  merge=$(git config --get "branch.$branch.merge" 2>/dev/null) || return 1
  if [[ $merge == "refs/heads/$head_ref" ]]; then
    remote_matches_identity "$remote" "$head_owner" "$head_repo"
    return
  fi
  if [[ $merge == "refs/pull/$number/head" ]]; then
    pr_url_identity "$pr_url" "$number" || return 1
    remote_matches_identity "$remote" "$PR_BASE_OWNER" "$PR_BASE_REPO"
    return
  fi
  return 1
}

record_pr_markers() {
  local branch=$1 pr_url=$2 head_oid=$3 old_url old_head
  old_url=$(git config --get "branch.$branch.worktree-pr-url" 2>/dev/null) || old_url=''
  old_head=$(git config --get "branch.$branch.worktree-pr-head" 2>/dev/null) || old_head=''
  git config "branch.$branch.worktree-pr-url" "$pr_url" || return 1
  if ! git config "branch.$branch.worktree-pr-head" "$head_oid"; then
    git config --unset-all "branch.$branch.worktree-pr-url" >/dev/null 2>&1 || true
    if [[ -n $old_url ]]; then
      git config "branch.$branch.worktree-pr-url" "$old_url" >/dev/null 2>&1 || true
    fi
    if [[ -n $old_head ]]; then
      git config "branch.$branch.worktree-pr-head" "$old_head" >/dev/null 2>&1 || true
    else
      git config --unset-all "branch.$branch.worktree-pr-head" >/dev/null 2>&1 || true
    fi
    return 1
  fi
}

cleanup_pr_fetch_worktree() {
  local path=${CWT_PR_FETCH_WORKTREE:-}
  [[ -n $path ]] || return 0
  if registered_at "$path"; then
    git worktree remove --force "$path" || return 1
  else
    rmdir "$path" 2>/dev/null || true
  fi
  CWT_PR_FETCH_WORKTREE=''
}

# Fetches the PR through gh without touching the reusable worktree. A detached
# disposable worktree lets gh resolve same-repo, fork, and authenticated remote
# details while leaving the real branch and its ignored local files untouched.
fetch_pr_head() {
  local number=$1 expected_oid=$2 path actual
  path=$(mktemp -d "$managed_root/.cwt-pr-fetch.XXXXXX") || return 1
  CWT_PR_FETCH_WORKTREE=$path
  if ! git worktree add --detach --quiet "$path" HEAD; then
    cleanup_pr_fetch_worktree >/dev/null 2>&1 || true
    return 1
  fi
  if ! (cd "$path" && gh pr checkout "$number" --detach); then
    cleanup_pr_fetch_worktree >/dev/null 2>&1 || true
    return 1
  fi
  actual=$(git -C "$path" rev-parse HEAD 2>/dev/null) || {
    cleanup_pr_fetch_worktree >/dev/null 2>&1 || true
    return 1
  }
  cleanup_pr_fetch_worktree || return 1
  [[ $actual == "$expected_oid" ]] || return 2
}

# Refuses every tree-shape collision that reset --hard could delete: an exact
# target object at an ignored path, or a target blob/symlink replacing a local
# directory that contains ignored files. Git evaluates each candidate set in a
# single batch; comparing every ignored path with every target-tree entry in
# Bash is prohibitively slow in repositories with large ignored dependency
# trees.
pr_ignored_paths_are_safe() {
  local target=$1 head_oid=$2 tree_file exact_file collision_file entry
  local target_path metadata rest object_type local_path check_rc=0
  local -a blocking_dirs=()
  PR_COLLISION_PATH=''
  tree_file=$(mktemp "${TMPDIR:-/tmp}/cwt-target-tree.XXXXXX") || {
    return 2
  }
  exact_file=$(mktemp "${TMPDIR:-/tmp}/cwt-exact-paths.XXXXXX") || {
    rm -f "$tree_file"
    return 2
  }
  collision_file=$(mktemp "${TMPDIR:-/tmp}/cwt-collisions.XXXXXX") || {
    rm -f "$tree_file" "$exact_file"
    return 2
  }
  if ! git -C "$target" ls-tree -r -t -z "$head_oid" >"$tree_file"; then
    rm -f "$tree_file" "$exact_file" "$collision_file"
    return 2
  fi
  while IFS= read -r -d '' entry; do
    case $entry in
      *$'\t'*) ;;
      *)
        rm -f "$tree_file" "$exact_file" "$collision_file"
        return 2
        ;;
    esac
    target_path=${entry#*$'\t'}
    metadata=${entry%%$'\t'*}
    rest=${metadata#* }
    object_type=${rest%% *}
    local_path="$target/$target_path"

    # Git tracks files and symlinks, not directories. Feed only existing
    # non-directory objects to check-ignore; a directory can collide only when
    # a non-tree target object would replace ignored content beneath it.
    if [[ -e $local_path || -L $local_path ]]; then
      if [[ ! -d $local_path || -L $local_path ]]; then
        printf '%s\0' "$target_path" >>"$exact_file" || {
          rm -f "$tree_file" "$exact_file" "$collision_file"
          return 2
        }
      elif [[ $object_type != tree ]]; then
        blocking_dirs+=("$target_path")
      fi
    fi
  done <"$tree_file"

  if [[ -s $exact_file ]]; then
    (cd "$target" && git check-ignore -z --stdin <"$exact_file" >"$collision_file") ||
      check_rc=$?
    case $check_rc in
      0 | 1) ;;
      *)
        rm -f "$tree_file" "$exact_file" "$collision_file"
        return 2
        ;;
    esac
    if [[ -s $collision_file ]]; then
      IFS= read -r -d '' PR_COLLISION_PATH <"$collision_file" || {
        rm -f "$tree_file" "$exact_file" "$collision_file"
        return 2
      }
      rm -f "$tree_file" "$exact_file" "$collision_file"
      return 1
    fi
  fi

  if ((${#blocking_dirs[@]})); then
    : >"$collision_file"
    if ! (cd "$target" && GIT_LITERAL_PATHSPECS=1 \
      git ls-files -z --others --ignored --exclude-standard -- "${blocking_dirs[@]}") \
      >"$collision_file"; then
      rm -f "$tree_file" "$exact_file" "$collision_file"
      return 2
    fi
    if [[ -s $collision_file ]]; then
      IFS= read -r -d '' PR_COLLISION_PATH <"$collision_file" || {
        rm -f "$tree_file" "$exact_file" "$collision_file"
        return 2
      }
      rm -f "$tree_file" "$exact_file" "$collision_file"
      return 1
    fi
  fi

  rm -f "$tree_file" "$exact_file" "$collision_file"
  return 0
}

# ------------------------------------------------------------- pr context file

# Refuses a session-folder route through a symlinked `cwt`, `sessions`, or
# `<name>` component, checked before ANY write or delete touches it. A
# worktree name is derived from a pull request's own head ref (case-preserved
# by gh, only the / -> - substitution applied) — an attacker-controlled name
# must never be trusted to redirect a write, or a recursive delete, outside
# the managed sessions root.
refuse_symlinked_session_path() {
  local name=$1
  [[ ! -L "$primary_common/cwt" ]] ||
    die "refusing a symlinked cwt directory: $primary_common/cwt"
  [[ ! -L "$primary_common/cwt/sessions" ]] ||
    die "refusing a symlinked sessions directory: $primary_common/cwt/sessions"
  [[ ! -L "$primary_common/cwt/sessions/$name" ]] ||
    die "refusing a symlinked session folder: $primary_common/cwt/sessions/$name"
}

# Physically resolves <dir> (an already-mkdir'd or already-verified-existing
# session folder) and checks it still lands under the managed sessions root
# even after resolution — defense in depth alongside the symlink refusals in
# refuse_symlinked_session_path, in case a component were swapped between
# that refusal and this resolution. Sets SESSION_FOLDER. Shared by
# ensure_session_folder and session_folder_if_present so the containment
# check lives in exactly one place.
resolve_session_folder() {
  local dir=$1 resolved
  resolved=$(cd -P "$dir" 2>/dev/null && pwd -P) ||
    die "cannot resolve session folder: $dir"
  case $resolved in
    "$primary_common/cwt/sessions/"*) ;;
    *) die "session folder resolved outside the managed sessions root: $resolved" ;;
  esac
  SESSION_FOLDER=$resolved
}

# Creates (if needed) and resolves the session folder for <name>. Sets
# SESSION_FOLDER.
ensure_session_folder() {
  local name=$1 dir
  refuse_symlinked_session_path "$name"
  dir="$primary_common/cwt/sessions/$name"
  mkdir -p "$dir" || die "cannot create session folder: $dir"
  resolve_session_folder "$dir"
}

# Like ensure_session_folder, but for deletion: a folder that was never
# created (no `pr` run for this worktree yet) or already removed is a no-op,
# signaled by returning 1 rather than dying. Sets SESSION_FOLDER on success.
session_folder_if_present() {
  local name=$1 dir
  refuse_symlinked_session_path "$name"
  dir="$primary_common/cwt/sessions/$name"
  [[ -e $dir ]] || return 1
  resolve_session_folder "$dir"
}

remove_session_folder() {
  local name=$1
  session_folder_if_present "$name" || return 0
  # `rm -rf "$SESSION_FOLDER"` would re-resolve every intermediate path
  # component itself, so a symlink swapped in between the check above and
  # this delete could still be followed. Deleting "./$name" from inside the
  # already-verified sessions root, re-checked with pwd -P and a final -L
  # test right before the rm, needs no further resolution of anything above
  # it — it cannot be redirected by a swap it never has to walk through.
  (
    cd -P "$primary_common/cwt/sessions" &&
      [[ $(pwd -P) == "$primary_common/cwt/sessions" ]] &&
      [[ ! -L $name ]] &&
      rm -rf -- "./$name"
  ) || die "cannot remove session folder: $SESSION_FOLDER"
}

valid_host() {
  local LC_ALL=C host=$1
  case $host in
    '' | .* | *[!A-Za-z0-9.-]*) return 1 ;;
  esac
  return 0
}

# Picks a fence at least one backtick longer than the longest run already
# present in $1 (minimum three, the shortest a markdown fence can be), so an
# untrusted PR description, comment, review, or diff containing its own
# fenced block can never terminate the section early. Sets PR_FENCE.
fence_for() {
  local content=$1 longest len
  # LC_ALL=C: `grep -oE` in a UTF-8 locale silently finds no match on a line
  # containing an invalid UTF-8 byte — not an error, so pipefail never catches
  # it — which undercounts the fence and lets that content break out of it.
  # A byte-oriented C-locale awk scan has no such blind spot.
  #
  # Checked explicitly rather than left to `set -e`: every caller of this
  # function runs inside write_pr_context, which is itself always invoked as
  # one side of `||` — that suspends errexit for its entire call tree,
  # including this one, so a failing awk would otherwise leave $longest
  # empty and silently fall through to the minimum 3-backtick fence,
  # regardless of how long a run the content actually contains.
  longest=$(printf '%s\n' "$content" | LC_ALL=C awk '{
    s = $0
    while (match(s, /`+/)) {
      if (RLENGTH > m) m = RLENGTH
      s = substr(s, RSTART + RLENGTH)
    }
  } END { print m + 0 }')
  [[ $longest =~ ^[0-9]+$ ]] || return 1
  len=$((longest + 1))
  ((len >= 3)) || len=3
  printf -v PR_FENCE '%*s' "$len" ''
  PR_FENCE=${PR_FENCE// /\`}
}

# True when a JSON value is an empty array, tolerating incidental whitespace.
# Used for the paginated review-comments list, which arrives as its own gh
# api call rather than a field inside the combined `gh pr view` blob below.
json_array_empty() {
  local stripped
  stripped=$(printf '%s' "$1" | tr -d '[:space:]')
  [[ -z $stripped || $stripped == '[]' ]]
}

# One ADR-0014 section — see docs/decisions/0014-pr-context-handoff.md's
# "Context file layout" for the contract this renders.
render_section() {
  local heading=$1 empty=$2 content=$3 marker=${4:-}
  printf '## %s\n' "$heading"
  if ((empty)); then
    printf '(none)\n\n'
    return 0
  fi
  # `|| exit 1`, not `|| return 1`: render_section always runs inside the
  # command-substitution subshell that builds $body in write_pr_context,
  # where errexit is suspended (see fence_for) — a `return` here would only
  # end THIS call and let the next render_section run anyway, silently
  # dropping a section rather than aborting. `exit` ends that subshell, which
  # the `body=$( ... ) || abort_pr_context ...` check below it catches.
  fence_for "$content" || exit 1
  printf '%s\n%s\n%s\n' "$PR_FENCE" "$content" "$PR_FENCE"
  [[ -z $marker ]] || printf '%s\n' "$marker"
  printf '\n'
}

# Sets PR_CONTEXT_ERROR to a short, specific reason and returns 1 — the one
# place write_pr_context's "clean up the in-flight temp file and fail"
# sequence is spelled out, instead of at each of its call sites. Both `die`
# call sites that report a write_pr_context failure print PR_CONTEXT_ERROR
# alongside the --no-review hint.
PR_CONTEXT_ERROR=''
abort_pr_context() {
  PR_CONTEXT_ERROR=$1
  rm -f "${CWT_PR_CONTEXT_TMP:-}"
  CWT_PR_CONTEXT_TMP=''
  return 1
}

# BSD mv's -h and GNU mv's -T both mean "never treat an existing destination
# as a directory to move INTO, even when it is a symlink pointing at one" —
# without that, a pr-context.md planted as a symlink to a directory would
# make the final move land the rendered context INSIDE that directory
# instead of replacing the symlink, writing through it. Detected once via a
# harmless failing invocation rather than assumed from uname, since this
# script is copied onto machines this repo does not control.
mv_no_target_directory() {
  if mv --version >/dev/null 2>&1; then
    mv -T -- "$1" "$2"
  else
    mv -h -- "$1" "$2"
  fi
}

# Fetches this pull request's review context via gh and writes it to
# <session-folder>/pr-context.md, replacing any existing copy, in the exact
# section order ADR 0014 defines. Every gh call targets $pr_url (and the
# host/owner/repo parsed from it) — never ambient repo/cwd inference. The
# file is assembled in a temp file registered with cleanup_on_exit and moved
# into place only once every call has succeeded and the pull request's
# identity and head still match the caller's own already-verified values, so
# a mid-fetch failure, a moved head, or a mismatched pull request never
# leaves a partial or stale pr-context.md.
#
# A symlink/containment/mkdir refusal on the session path (inside
# ensure_session_folder) is left to `die` outright rather than returned here
# — that signals tampering, not a transient gh failure, and stays fatal even
# under --no-review. Only a gh fetch failure returns a status here, via
# abort_pr_context, for the caller to report and for --no-review to skip.
#
# PR_CONTEXT_BASE_REF holds the validated base branch name (below) after a
# successful return, for the Req 4b skill-shadowing guard: it computes its own
# merge-base locally rather than trusting gh's diff text (gh is not pinned to
# the commit this worktree has checked out), but it still needs to know WHICH
# base branch to diff against — the same one this function already fetched
# and validated, not a second gh call of its own.
PR_CONTEXT_BASE_REF=''
write_pr_context() {
  local number=$1 pr_url=$2 expected_oid=$3 name=$4 head_ref=$5 cross=$6
  local folder pr_host pr_owner pr_repo tmp meta

  PR_CONTEXT_BASE_REF=''
  ensure_session_folder "$name"
  folder=$SESSION_FOLDER
  rm -f "$folder/pr-context.md"
  [[ ! -e "$folder/pr-context.md" && ! -L "$folder/pr-context.md" ]] ||
    abort_pr_context "cannot remove the stale pr-context.md for pull request #$number before fetching" || return 1

  pr_url_identity "$pr_url" "$number" ||
    abort_pr_context "pull request #$number has an invalid canonical URL" || return 1
  pr_host=$PR_HOST
  pr_owner=$PR_BASE_OWNER
  pr_repo=$PR_BASE_REPO

  tmp=$(mktemp "$folder/.pr-context.XXXXXX") ||
    abort_pr_context "cannot create a temp file for pull request #$number's context" || return 1
  CWT_PR_CONTEXT_TMP=$tmp

  # tojson forces every result to a JSON-ENCODED STRING, so gh's raw-string
  # printing (like jq -r) emits it unquoted and single-line regardless of
  # what the source value looked like — the trick that lets 19 differently
  # shaped results share one newline-delimited `--jq` output, safely, even
  # though several of the raw fields (title, body, comments, reviews) are
  # attacker-controlled text that would otherwise embed literal newlines.
  meta=$(gh pr view "$pr_url" \
    --json number,url,author,baseRefName,headRefName,headRefOid,isCrossRepository,title,body,closingIssuesReferences,files,changedFiles,comments,reviews \
    --jq '
      .number,
      .url,
      .author.login,
      .baseRefName,
      .headRefName,
      .headRefOid,
      .isCrossRepository,
      (.title // "" | length),
      (.body // "" | length),
      (.closingIssuesReferences // [] | length),
      (.files // [] | length),
      (.changedFiles // 0),
      (.comments // [] | length),
      (.reviews // [] | length),
      ({title,body}|tojson),
      ({closingIssuesReferences}|tojson),
      ({files}|tojson),
      ({comments}|tojson),
      ({reviews}|tojson)
    ' 2>/dev/null) ||
    abort_pr_context "gh pr view failed while fetching pull request #$number's context" || return 1

  local pr_number pr_canonical_url pr_author pr_base pr_head pr_head_oid pr_cross
  local title_len body_len issues_len files_len changed_files comments_len reviews_len
  local description_json issues_json files_json comments_json reviews_json
  pr_number=$(printf '%s\n' "$meta" | sed -n '1p')
  pr_canonical_url=$(printf '%s\n' "$meta" | sed -n '2p')
  pr_author=$(printf '%s\n' "$meta" | sed -n '3p')
  pr_base=$(printf '%s\n' "$meta" | sed -n '4p')
  pr_head=$(printf '%s\n' "$meta" | sed -n '5p')
  pr_head_oid=$(printf '%s\n' "$meta" | sed -n '6p')
  pr_cross=$(printf '%s\n' "$meta" | sed -n '7p')
  title_len=$(printf '%s\n' "$meta" | sed -n '8p')
  body_len=$(printf '%s\n' "$meta" | sed -n '9p')
  issues_len=$(printf '%s\n' "$meta" | sed -n '10p')
  files_len=$(printf '%s\n' "$meta" | sed -n '11p')
  changed_files=$(printf '%s\n' "$meta" | sed -n '12p')
  comments_len=$(printf '%s\n' "$meta" | sed -n '13p')
  reviews_len=$(printf '%s\n' "$meta" | sed -n '14p')
  description_json=$(printf '%s\n' "$meta" | sed -n '15p')
  issues_json=$(printf '%s\n' "$meta" | sed -n '16p')
  files_json=$(printf '%s\n' "$meta" | sed -n '17p')
  comments_json=$(printf '%s\n' "$meta" | sed -n '18p')
  reviews_json=$(printf '%s\n' "$meta" | sed -n '19p')

  # Every value gh just returned is checked against the caller's OWN
  # already-verified identity here, not only at the final re-read below.
  # Without this, a combined view call that answers about the wrong pull
  # request, or one whose head has already moved by the time this call
  # runs, would still have its comments/checks/diff fetched and rendered
  # before anything noticed — the final re-read alone only catches a head
  # that is STILL moved by the time it runs, not one that moved away and
  # back in between (an ABA change hidden from a last-read-only check).
  # This narrows that window, it does not close it: the review-comments,
  # checks, and diff calls below are still not individually pinned to
  # expected_oid, so a head that moves away and back between THIS check and
  # the final re-read can still have them describe a commit other than the
  # one this context claims to be about.
  [[ $pr_number == "$number" ]] ||
    abort_pr_context "gh returned pull request #$pr_number's data for #$number" || return 1
  [[ $pr_canonical_url == "$pr_url" ]] ||
    abort_pr_context "gh returned a different canonical URL for pull request #$number" || return 1
  [[ $pr_head == "$head_ref" ]] ||
    abort_pr_context "gh returned a different head ref for pull request #$number" || return 1
  valid_head_oid "$pr_head_oid" ||
    abort_pr_context "pull request #$number returned an invalid head object ID" || return 1
  [[ $pr_head_oid == "$expected_oid" ]] ||
    abort_pr_context "pull request #$number changed while fetching its context; run cwt pr $number again" || return 1
  [[ $pr_cross == true || $pr_cross == false ]] ||
    abort_pr_context "pull request #$number returned an invalid fork flag" || return 1
  valid_pr_author "$pr_author" ||
    abort_pr_context "pull request #$number returned an invalid author login" || return 1
  git check-ref-format --branch "$pr_base" >/dev/null 2>&1 ||
    abort_pr_context "pull request #$number returned an invalid base branch name" || return 1
  PR_CONTEXT_BASE_REF=$pr_base

  local field
  for field in title_len body_len issues_len files_len changed_files comments_len reviews_len; do
    case ${!field} in
      '' | *[!0-9]*) abort_pr_context "pull request #$number returned a non-numeric $field" || return 1 ;;
    esac
  done

  local review_comments_json review_comments_lines
  # Real gh rejects `--paginate --slurp` combined with `--jq` outright ("the
  # --slurp option is not supported with --jq or --template"), so --slurp is
  # dropped here. `--jq '.[] | tojson'` runs per PAGE instead, emitting one
  # compact JSON object per line for every comment across every page — bash
  # joins the lines into an array below, with no jq dependency of its own.
  review_comments_lines=$(gh api --hostname "$pr_host" --paginate --jq '.[] | tojson' \
    "repos/$pr_owner/$pr_repo/pulls/$number/comments" 2>/dev/null) ||
    abort_pr_context "gh api failed while fetching pull request #$number's review comments" || return 1
  if [[ -z $review_comments_lines ]]; then
    review_comments_json='[]'
  else
    review_comments_json="[$(printf '%s' "$review_comments_lines" | tr '\n' ',')]"
  fi

  local checks_out checks_rc=0 checks_errfile checks_err checks_err_lower
  checks_errfile=$(mktemp "${TMPDIR:-/tmp}/cwt-pr-checks-err.XXXXXX") ||
    abort_pr_context "cannot create a temp file for pull request #$number's CI checks" || return 1
  CWT_PR_CHECKS_ERR_FILE=$checks_errfile
  checks_out=$(gh pr checks "$pr_url" 2>"$checks_errfile") || checks_rc=$?
  checks_err=$(cat "$checks_errfile" 2>/dev/null)
  rm -f "$checks_errfile"
  CWT_PR_CHECKS_ERR_FILE=''
  checks_err_lower=$(printf '%s' "$checks_err" | tr '[:upper:]' '[:lower:]')
  # Exit 8 is gh's own "checks are still pending" signal, and exit 1 is
  # overloaded: "a check failed" (data) and "gh could not run at all" (a real
  # failure) look identical unless stdout carries a result or stderr names
  # the no-checks-configured case explicitly.
  case $checks_rc in
    0 | 8) ;;
    1)
      if [[ -z $checks_out && $checks_err_lower != *'no checks reported'* ]]; then
        abort_pr_context "gh pr checks failed for pull request #$number: ${checks_err:-no output}" || return 1
      fi
      ;;
    *)
      abort_pr_context "gh pr checks failed for pull request #$number (exit $checks_rc): ${checks_err:-no output}" || return 1
      ;;
  esac

  local diff_out
  diff_out=$(gh pr diff "$pr_url" 2>/dev/null) ||
    abort_pr_context "gh pr diff failed while fetching pull request #$number's context" || return 1

  # Re-read after every other call: a head that moved mid-fetch means the
  # rest of this context (comments, checks, diff) may already describe a
  # commit the worktree no longer has checked out.
  local final_oid
  final_oid=$(gh pr view "$pr_url" --json headRefOid --jq '.headRefOid' 2>/dev/null) ||
    abort_pr_context "gh pr view failed while re-checking pull request #$number's head" || return 1
  valid_head_oid "$final_oid" ||
    abort_pr_context "pull request #$number returned an invalid head object ID on re-check" || return 1
  [[ $final_oid == "$expected_oid" ]] ||
    abort_pr_context "pull request #$number changed while fetching its context; run cwt pr $number again" || return 1

  local fetched changed_marker='' review_comments_empty=0 description_empty
  fetched=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if ((changed_files > files_len)); then
    changed_marker="(truncated at $files_len)"
  fi
  json_array_empty "$review_comments_json" && review_comments_empty=1
  description_empty=$((title_len == 0 && body_len == 0))

  # Rendered into a variable — with a trailing marker that survives command
  # substitution's newline-stripping and is trimmed back off below — rather
  # than a `{ ... } >"$tmp"` group, which would report only the LAST
  # command's exit status and hide an earlier write failure inside it. The
  # `||` below is what catches render_section's `exit 1` on a fence_for
  # failure: that only ends this subshell, so the failure is otherwise
  # invisible to everything after it (see render_section).
  local body
  body=$( {
    printf '# Pull request #%s\n\n' "$number"
    printf -- '- URL: %s\n' "$pr_url"
    printf -- '- Author: %s\n' "$pr_author"
    printf -- '- Base: %s\n' "$pr_base"
    printf -- '- Head: %s\n' "$head_ref"
    printf -- '- Head commit: %s\n' "$expected_oid"
    printf -- '- Fork: %s\n' "$cross"
    printf -- '- Fetched: %s\n\n' "$fetched"

    render_section 'Description' "$description_empty" "$description_json"
    render_section 'Linked issues' "$((issues_len == 0))" "$issues_json"
    render_section 'Changed files' "$((files_len == 0))" "$files_json" "$changed_marker"
    render_section 'CI checks' "$((${#checks_out} == 0))" "$checks_out"
    render_section 'Conversation comments' "$((comments_len == 0))" "$comments_json"
    render_section 'Reviews' "$((reviews_len == 0))" "$reviews_json"
    render_section 'Review comments' "$review_comments_empty" "$review_comments_json"
    render_section 'Diff' "$((${#diff_out} == 0))" "$diff_out"
    printf 'X'
  } ) || abort_pr_context "could not render pull request #$number's context" || return 1
  body=${body%X}

  printf '%s' "$body" >"$tmp" ||
    abort_pr_context "could not write pull request #$number's context to a temp file" || return 1

  mv_no_target_directory "$tmp" "$folder/pr-context.md" ||
    abort_pr_context "could not move pull request #$number's context into place" || return 1
  [[ -f "$folder/pr-context.md" && ! -L "$folder/pr-context.md" ]] ||
    abort_pr_context "pull request #$number's context did not land as a regular file" || return 1
  CWT_PR_CONTEXT_TMP=''
}

# Req 4b (security-sensitive). Decides whether the pull request's own checked-
# out diff touches a path under .agents or .codex, relative to its merge base
# with the base branch — Codex, unlike Claude, does not rank a personal skill
# above a project one on a name collision, so a pull request shipping
# .agents/skills/pr-review could otherwise replace the review the startup
# prompt is about to launch.
#
# Decided from a LOCAL git diff against the worktree cwt already verified,
# never from gh's diff text: gh is not pinned to the commit this worktree has
# checked out, so a head that moved and moved back between calls (an
# A->B->A race) could make gh describe a commit this worktree no longer
# holds. `--no-renames` is an explicit guarantee, not a dependency on how a
# given git version orders pathspec filtering against rename detection: with
# it, a file moved OUT of .agents always reports as a plain delete at the old
# path — its own independent line, which this scan matches on its own, never
# bundled into a single `R` line whose old-side match would otherwise have to
# be trusted to git's rename heuristic.
#
# The base ref is always the fully qualified refs/remotes/origin/$base_ref:
# git's own ref-disambiguation order tries refs/heads before refs/remotes, so
# the short "origin/$base_ref" would resolve to a LOCAL branch of that exact
# name if one existed — e.g. a pull request whose own head branch happens to
# be named "origin/main" — comparing HEAD against HEAD and finding nothing.
#
# No pathspec restricts the diff: `:(icase)` only folds ASCII, so a case-
# insensitive filesystem (APFS) can open a non-ASCII confusable like U+017F
# ("ſ") as ".agents", past a pathspec built from that literal string. Every
# changed path is read instead, and shadow_component_matches decides each
# one's own top-level component — folding ASCII case itself, and failing
# closed on any component carrying a byte outside printable ASCII.
#
# Fails closed: a base ref cwt cannot resolve, a merge-base git cannot
# compute, or a diff git cannot run, withholds exactly like a confirmed
# match — none of those states is "proven safe". Sets PR_SHADOW_REASON to
# describe why, for the caller's warning.
PR_SHADOW_REASON=''

# shadow_lowercase <name> — ASCII-only lowercasing, pinned to the C locale so
# this process's own LC_ALL can never change what counts as upper/lower.
shadow_lowercase() {
  printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]'
}

# shadow_component_matches <path-component> — true for a literal (ASCII-
# case-insensitive) .agents/.codex, or for ANY component carrying a byte
# outside printable ASCII. A case-insensitive filesystem can fold a non-ASCII
# confusable onto ".agents" (see the comment above pr_shadows_skills); nothing
# here can vouch for what such a byte actually folds to, so it fails closed.
shadow_component_matches() {
  local first=$1 LC_ALL=C
  case $first in
    *[!\ -~]*) return 0 ;;
  esac
  case $(shadow_lowercase "$first") in
    .agents | .codex) return 0 ;;
  esac
  return 1
}

# shadow_toplevel_ids <target> <commit-ish> — prints "<lowercased-name>
# <mode> <object> <name>" for every top-level tree entry whose ASCII-case-
# folded name is .agents or .codex. The trailing <name> keeps the on-disk
# case so shadow_base_diverged treats a case-only rename as a divergence.
# -z is still required to read ls-tree safely (an adversarial top-level name
# could carry a literal newline), but once filtered down to exactly those
# two literals the printed output is plain ASCII, so the caller can compare
# it with ordinary string equality.
#
# Fails closed (returns 1) if ANY top-level entry's name carries a byte
# outside printable ASCII — same *[!\ -~]* test as shadow_component_matches —
# not just one that happens to literal-match .agents/.codex after folding.
# ASCII-only lowering can't tell what a non-ASCII byte folds to on a
# case-insensitive filesystem (APFS folds U+017F "ſ" onto "s"), so a
# confusable top-level name (".agentſ") would otherwise just fail the
# literal-string comparison below and be silently treated as irrelevant.
shadow_toplevel_ids() {
  local target=$1 commit=$2 file entry metadata name mode type obj lower LC_ALL=C
  file=$(mktemp "${TMPDIR:-/tmp}/cwt-pr-shadow-tree.XXXXXX") || return 1
  if ! git -C "$target" ls-tree -z "$commit" >"$file" 2>/dev/null; then
    rm -f "$file"
    return 1
  fi
  while IFS= read -r -d '' entry; do
    case $entry in
      *$'\t'*) ;;
      *)
        rm -f "$file"
        return 1
        ;;
    esac
    metadata=${entry%%$'\t'*}
    name=${entry#*$'\t'}
    case $name in
      *[!\ -~]*)
        rm -f "$file"
        return 1
        ;;
    esac
    read -r mode type obj <<<"$metadata"
    lower=$(shadow_lowercase "$name")
    [[ $lower == .agents || $lower == .codex ]] && printf '%s %s %s %s\n' "$lower" "$mode" "$obj" "$name"
  done <"$file"
  rm -f "$file"
}

# shadow_base_diverged <target> <head-oid> <base-oid> — true when HEAD's own
# .agents or .codex differs from what origin/$base_ref CURRENTLY ships,
# including one existing only on one side. Catches what the merge-base diff
# in pr_shadows_skills cannot: a pull request that carries an OLD
# .agents/.codex unchanged from its own merge base, while the base branch has
# since changed it — no diff shows up against the merge base, yet the pull
# request no longer matches what review against the real base would see.
shadow_base_diverged() {
  local target=$1 head_oid=$2 base_oid=$3 head_ids base_ids
  head_ids=$(shadow_toplevel_ids "$target" "$head_oid") || {
    PR_SHADOW_REASON='could not read the .agents/.codex trees'
    return 0
  }
  base_ids=$(shadow_toplevel_ids "$target" "$base_oid") || {
    PR_SHADOW_REASON='could not read the .agents/.codex trees'
    return 0
  }
  [[ "$(printf '%s\n' "$head_ids" | sort)" == "$(printf '%s\n' "$base_ids" | sort)" ]] && return 1
  return 0
}

# shadow_toplevel_symlink <target> <commit-ish> — true when any top-level
# .agents/.codex entry at <commit-ish> (any ASCII-case variant, per
# shadow_toplevel_ids) is itself a symlink, or has one anywhere beneath it.
# Catches what neither the diff scan in pr_shadows_skills nor
# shadow_base_diverged can: a symlink the base branch already ships
# (".agents -> tools/agents", or a nested
# ".agents/skills/pr-review -> ../../shared/pr-review") whose own top-level
# object id the pull request never changes, because it only edits content at
# the symlink's TARGET path elsewhere in the tree.
#
# Recurses via the entry's own tree object id (mode 040000), never a `--
# <name>` pathspec: a pathspec-restricted ls-tree errors under
# GIT_GLOB_PATHSPECS/GIT_ICASE_PATHSPECS (exit 128), which used to withhold
# every pull request with the wrong reason regardless of whether .agents/
# .codex held anything suspicious at all. Reading the mode shadow_toplevel_ids
# already returned also means a mode-120000 entry needs no ls-tree call —
# it's already the symlink being searched for.
#
# Fails closed on any git/mktemp error, setting PR_SHADOW_REASON like
# shadow_base_diverged so the caller doesn't overwrite a real failure reason
# with the generic "ships a symlink" message.
shadow_toplevel_symlink() {
  local target=$1 commit=$2 ids line lower mode obj name file entry entry_mode
  ids=$(shadow_toplevel_ids "$target" "$commit") || {
    PR_SHADOW_REASON='could not read the .agents/.codex trees'
    return 0
  }
  [[ -z $ids ]] && return 1
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    read -r lower mode obj name <<<"$line"
    [[ $mode == 120000 ]] && return 0
    [[ $mode == 040000 ]] || continue
    file=$(mktemp "${TMPDIR:-/tmp}/cwt-pr-shadow-symlink.XXXXXX") || {
      PR_SHADOW_REASON='could not read the .agents/.codex trees'
      return 0
    }
    if ! git -C "$target" ls-tree -r -z "$obj" >"$file" 2>/dev/null; then
      rm -f "$file"
      PR_SHADOW_REASON='could not read the .agents/.codex trees'
      return 0
    fi
    while IFS= read -r -d '' entry; do
      entry_mode=${entry%% *}
      if [[ $entry_mode == 120000 ]]; then
        rm -f "$file"
        return 0
      fi
    done <"$file"
    rm -f "$file"
  done <<<"$ids"
  return 1
}

pr_shadows_skills() {
  local target=$1 base_ref=$2 head_oid=$3
  local base_ref_q base_oid merge_base diff_file path first
  PR_SHADOW_REASON=''

  base_ref_q="refs/remotes/origin/$base_ref"
  base_oid=$(git -C "$target" rev-parse --verify --quiet "$base_ref_q^{commit}" 2>/dev/null) || {
    PR_SHADOW_REASON="has no $base_ref_q cwt could verify"
    return 0
  }

  merge_base=$(git -C "$target" merge-base "$base_oid" "$head_oid" 2>/dev/null) || {
    PR_SHADOW_REASON="has no merge base cwt could compute with origin/$base_ref"
    return 0
  }

  diff_file=$(mktemp "${TMPDIR:-/tmp}/cwt-pr-shadow-diff.XXXXXX") || {
    PR_SHADOW_REASON='could not be diffed against its merge base'
    return 0
  }
  if ! git -C "$target" diff --name-only -z --no-renames \
    "$merge_base" "$head_oid" >"$diff_file" 2>/dev/null; then
    rm -f "$diff_file"
    PR_SHADOW_REASON='could not be diffed against its merge base'
    return 0
  fi
  while IFS= read -r -d '' path; do
    first=${path%%/*}
    if shadow_component_matches "$first"; then
      rm -f "$diff_file"
      return 0
    fi
  done <"$diff_file"
  rm -f "$diff_file"

  if shadow_toplevel_symlink "$target" "$head_oid"; then
    PR_SHADOW_REASON=${PR_SHADOW_REASON:-'ships a symlink under .agents/.codex'}
    return 0
  fi

  if shadow_base_diverged "$target" "$head_oid" "$base_oid"; then
    PR_SHADOW_REASON=${PR_SHADOW_REASON:-"carries a .agents/.codex tree that differs from origin/$base_ref; rebase onto the current base to get the review prompt"}
    return 0
  fi
  return 1
}

# Returns 0 (setting PR_SHADOW_REASON) when the review must be withheld. The
# guard reads the local origin/<base> ref; a missing or stale ref would make it
# fail closed or judge old data, so it must never run after a failed fetch.
# git's stderr stays visible to tell an auth failure from a missing base.
pr_review_withheld() {
  local target=$1 base_ref=$2 head_oid=$3
  if ! GIT_TERMINAL_PROMPT=0 remote_git -C "$target" fetch --quiet --no-tags origin \
    "+refs/heads/$base_ref:refs/remotes/origin/$base_ref"; then
    PR_SHADOW_REASON="has a base branch cwt could not fetch (origin/$base_ref)"
    return 0
  fi
  pr_shadows_skills "$target" "$base_ref" "$head_oid"
}

# Decides what a `cwt pr` launch does with write_pr_context's outcome: whether
# a fetch failure is fatal (per --no-review), and whether to send the startup
# review prompt. Shared by the fresh-checkout and reused-worktree paths so
# both pieces of the contract live in exactly one place. cwt has no --add-dir
# equivalent — that is a Claude-only passthrough flag — and additionally runs
# the Req 4b guard above before building the prompt. clwt runs the matching
# guard too, scoped to the top-level .claude directory: Claude ranks a
# project subagent above a personal one (the opposite of its skill
# precedence), so a pull request shipping .claude/agents/pr-security.md could
# otherwise replace that pass of the auto-started /pr-review. Under
# --no-review neither the base fetch nor the guard runs: no prompt is sent
# either way.
finish_pr_context() {
  local no_review=$1 number=$2 ctx_ok=$3 target=$4 base_ref=$5 head_oid=$6
  local msg="${PR_CONTEXT_ERROR:-could not fetch the review context for pull request #$number}"
  PR_REVIEW_SKIPPED=0
  if ((no_review)); then
    ((ctx_ok)) || warn "$msg"
    return 0
  fi
  ((ctx_ok)) || die "$msg; run 'cwt pr $number --no-review' to skip it"
  if pr_review_withheld "$target" "$base_ref" "$head_oid"; then
    warn "pull request #$number ${PR_SHADOW_REASON:-touches a path under .agents or .codex} — the review was not started automatically"
    PR_REVIEW_SKIPPED=1
    return 0
  fi
  # `--` fences the prompt from any variadic option already sitting at the
  # end of LAUNCH_ARGS (a developer's own passthrough option) so it is never
  # read as one more value for that option instead of its own argument. The
  # literal `$` is built via a single-quoted value, never interpolated
  # straight into a double-quoted string, so it can never be misread as the
  # start of a (nonexistent) `$pr` shell variable.
  local prompt
  prompt=$(printf '%s %s %s' '$pr-review' "$number" "$SESSION_FOLDER/pr-context.md")
  LAUNCH_ARGS+=(-- "$prompt")
}

reuse_pr_or_refuse() {
  local branch=$1 existing=$2 number=$3 pr_url=$4 head_oid=$5
  local head_ref=$6 head_owner=$7 head_repo=$8 cross=$9 no_review=${10}
  local marker_url marker_head legacy=0 current collision_rc final ctx_ok

  require_reusable_worktree "$branch" "$existing"

  marker_url=$(git config --get "branch.$branch.worktree-pr-url" 2>/dev/null) || marker_url=''
  marker_head=$(git config --get "branch.$branch.worktree-pr-head" 2>/dev/null) || marker_head=''
  if [[ -n $marker_url || -n $marker_head ]]; then
    [[ -n $marker_url && -n $marker_head ]] ||
      die "cannot verify the pull request identity for reused worktree: $existing"
    [[ $marker_url == "$pr_url" ]] ||
      die "$branch is already a worktree for a different pull request: $marker_url"
    valid_head_oid "$marker_head" ||
      die "cannot verify the previous pull request head for reused worktree: $existing"
  else
    branch_tracks_pr_head "$branch" "$number" "$pr_url" "$head_ref" "$head_owner" "$head_repo" ||
      die "cannot verify that reused worktree belongs to pull request #$number: $existing"
    legacy=1
  fi

  if worktree_is_dirty "$existing" refresh; then
    die "worktree has uncommitted or untracked work, refusing to refresh: $existing"
  fi

  local fetch_rc=0
  fetch_pr_head "$number" "$head_oid" || fetch_rc=$?
  case $fetch_rc in
    0) ;;
    2) die "pull request #$number changed while its head was being fetched; run cwt pr $number again" ;;
    *) die "gh could not fetch pull request #$number for safe reuse" ;;
  esac

  pr_ignored_paths_are_safe "$existing" "$head_oid" || collision_rc=$?
  case ${collision_rc:-0} in
    0) ;;
    1) die "ignored local path would be overwritten by pull request #$number, refusing to refresh: $PR_COLLISION_PATH" ;;
    *) die "cannot inspect ignored local paths in $existing; refusing to refresh" ;;
  esac

  current=$(git -C "$existing" rev-parse HEAD 2>/dev/null) ||
    die "cannot resolve the current head in reused worktree: $existing"
  if [[ $current == "$head_oid" ]]; then
    :
  elif git -C "$existing" merge-base --is-ancestor "$current" "$head_oid"; then
    (cd "$existing" && git merge --ff-only "$head_oid") ||
      die "could not fast-forward reused worktree to pull request #$number"
  elif ((legacy == 0)) && [[ $current == "$marker_head" ]]; then
    (cd "$existing" && git reset --hard "$head_oid") ||
      die "could not refresh rewritten pull request #$number"
  else
    die "reused worktree has local or unverifiable commits, refusing to refresh: $existing"
  fi

  final=$(git -C "$existing" rev-parse HEAD 2>/dev/null) ||
    die "cannot verify refreshed pull request #$number"
  [[ $final == "$head_oid" ]] ||
    die "refreshed worktree does not match pull request #$number; refusing to launch"
  record_pr_markers "$branch" "$pr_url" "$head_oid" ||
    die "could not record the verified identity for pull request #$number"

  ctx_ok=1
  write_pr_context "$number" "$pr_url" "$head_oid" "${existing##*/}" "$head_ref" "$cross" || ctx_ok=0
  finish_pr_context "$no_review" "$number" "$ctx_ok" "$existing" "$PR_CONTEXT_BASE_REF" "$head_oid"

  note "reusing existing worktree for $branch at pull request #$number head"
  if [[ $cross == true ]]; then
    warn "pull request #$number comes from a fork — this is code you did not write, and opening it here runs it on your machine"
  fi
  launch "$existing"
}

# Removing the directory you are standing in leaves the shell in a path that no
# longer exists. Realistic, since you open a terminal in a worktree and then tidy
# up from it.
refuse_if_caller_inside() {
  local target=$1 here
  here=$(pwd -P)
  if [[ $here == "$target" || $here == "$target"/* ]]; then
    die "refusing to remove the worktree you are standing in: $target"
  fi
}

# Resolves <branch> to a managed worktree, applying every guard that must hold
# before anything destructive happens. Sets `resolved_worktree`.
resolve_removable() {
  local branch=$1 target
  validate_branch "$branch"
  target=$(branch_worktree "$branch") ||
    die "no worktree checked out for branch: $branch"
  require_managed_worktree "$target"
  target=$(cd -P "$target" && pwd -P)
  refuse_if_caller_inside "$target"
  resolved_worktree=$target
}

# Appended to every refusal so the user knows the state and the way out.
readonly BRANCH_REFUSAL_TAIL='nothing was removed (drop --delete-branch to remove only the worktree)'

# Predicts `git branch -d` before anything is removed. -d checks the upstream
# when its ref exists, else HEAD — never both — and HEAD is the caller's, as
# for the later -d. Returns 0 when -d will accept, 1 when the tip is proven
# not an ancestor (the only case worth asking GitHub about). Anything else,
# incl. merge-base exit >1, dies: a check that could not run proves nothing.
# Called after `!`, so errexit is off inside: every command checks its own status.
predict_branch_delete() {
  local branch=$1 upstream ref=HEAD rc=0
  upstream=$(git for-each-ref --format='%(upstream)' "refs/heads/$branch") ||
    die "cannot read the upstream of branch $branch; $BRANCH_REFUSAL_TAIL"
  if [[ -n $upstream ]] && git show-ref --verify --quiet "$upstream"; then
    ref=$upstream
  fi
  if git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
    if git merge-base --is-ancestor "refs/heads/$branch" "$ref"; then
      return 0
    else
      rc=$?
    fi
  else
    rc=2
  fi
  if ((rc == 1)); then
    return 1
  fi
  die "refusing to delete branch $branch: cannot verify that it is merged into $ref; $BRANCH_REFUSAL_TAIL"
}

# Sets verified_tip/verified_pr, or dies. --head matches the branch name alone,
# so a fork's same-named pull request comes back too.
verify_squash_merged() {
  local branch=$1 tip records num state head cross oid
  local merged_same='' merged_other='' other_num='' other_state='' fork_num=''
  tip=$(git rev-parse --verify --quiet "refs/heads/$branch") ||
    die "cannot read the tip of branch $branch; $BRANCH_REFUSAL_TAIL"
  require_gh 'remove --delete-branch' "; $BRANCH_REFUSAL_TAIL"
  records=$(gh pr list --repo "$owner/$repo" --head "$branch" --state all --limit 100 \
    --json number,state,headRefName,isCrossRepository,headRefOid \
    --jq '.[] | [.number, .state, .headRefName, .isCrossRepository, .headRefOid] | @tsv') ||
    die "gh could not list pull requests for $owner/$repo; $BRANCH_REFUSAL_TAIL"
  # headRefOid stays last: an empty field collapses under IFS tab and shifts
  # the rest left, which the oid check then catches.
  while IFS=$'\t' read -r num state head cross oid; do
    [[ -n $num$state$head$cross$oid ]] || continue
    if [[ ! $num =~ ^[0-9]+$ ]] || [[ ! $state =~ ^(OPEN|CLOSED|MERGED)$ ]] ||
      [[ ! $cross =~ ^(true|false)$ ]] || [[ ! $oid =~ ^[0-9a-f]{40,64}$ ]]; then
      die "unexpected pull request record from gh for $owner/$repo; $BRANCH_REFUSAL_TAIL"
    fi
    [[ $head == "$branch" ]] || continue
    if [[ $cross == true ]]; then
      [[ -n $fork_num ]] || fork_num=$num
      continue
    fi
    if [[ $state == MERGED && $oid == "$tip" ]]; then
      merged_same=$num
    elif [[ $state == MERGED ]]; then
      merged_other=$num
    elif [[ -z $other_num ]]; then
      other_num=$num
      other_state=$state
    fi
  done <<<"$records"

  if [[ -n $merged_same ]]; then
    verified_tip=$tip
    verified_pr=$merged_same
    return 0
  fi
  if [[ -n $merged_other ]]; then
    die "refusing to delete branch $branch: merged pull request #$merged_other has a different head than the local tip; $BRANCH_REFUSAL_TAIL"
  fi
  if [[ -n $other_num ]]; then
    die "refusing to delete branch $branch: pull request #$other_num is $other_state, not merged; $BRANCH_REFUSAL_TAIL"
  fi
  if [[ -n $fork_num ]]; then
    die "refusing to delete branch $branch: pull request #$fork_num is from a fork, which remove --delete-branch does not accept; $BRANCH_REFUSAL_TAIL"
  fi
  die "refusing to delete branch $branch: no pull request for it in $owner/$repo; $BRANCH_REFUSAL_TAIL"
}

# Reports what removal will destroy, then removes. Shared by remove and prune.
remove_worktree() {
  local target=$1 branch=$2 delete_branch=$3
  local -a doomed=()
  local f verified_tip='' verified_pr='' # set by verify_squash_merged

  if ((delete_branch)) && ! predict_branch_delete "$branch"; then
    verify_squash_merged "$branch"
  fi

  # Checked before the worktree is touched, not just before the session
  # folder's own delete below: refusing only afterward would leave the
  # worktree already gone while the tampered session path is still
  # unresolved — a worse partial-failure state than refusing up front.
  refuse_symlinked_session_path "${target##*/}"

  local ignored
  ignored=$(worktree_ignored_files "$target") ||
    die "cannot list ignored files in $target; refusing to remove without knowing what would be destroyed"
  while IFS= read -r f; do
    if [[ -n $f ]]; then doomed+=("$f"); fi
  done <<<"$ignored"

  if ((${#doomed[@]})); then
    note "removing will destroy ${#doomed[@]} ignored file(s):"
    printf '  %s\n' "${doomed[@]}"
  fi

  git worktree remove "$target"
  note "removed $target"

  # Shared by remove and prune (the only two callers), so a PR worktree's
  # pr-context.md is cleaned up regardless of which command removed it.
  remove_session_folder "${target##*/}"

  if ((delete_branch)); then
    if [[ -n $verified_pr ]]; then
      # The worktree can gain a commit between the GitHub check and its
      # removal; -D would destroy it.
      [[ $(git rev-parse --verify --quiet "refs/heads/$branch") == "$verified_tip" ]] ||
        die "removed the worktree but kept branch $branch: its tip moved after the pull request check"
      git branch -D "$branch"
      note "deleted squash-merged branch $branch (PR #$verified_pr)"
    else
      # -d, not -D: backstop if the prediction above was wrong.
      git branch -d "$branch"
      note "deleted branch $branch"
    fi
  fi
}

cmd_root() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 0)) || die 'root takes no arguments'
  launch "$primary"
}

# Probed once, up front — never inferred from a failing per-branch query. A branch
# with no PR and a closed-but-unmerged PR both make `gh pr view` exit non-zero,
# which is the same signal an unauthenticated gh gives. Conflating them either
# turns a broken gh into a silent "nothing to prune", or turns every PR-less
# branch into a deletion candidate. Neither is acceptable for a bulk delete.
require_gh() {
  local what=$1 suffix=${2:-}
  command -v gh >/dev/null 2>&1 ||
    die "$what needs gh to reach GitHub, but gh is not on PATH$suffix"
  gh auth status >/dev/null 2>&1 ||
    die "$what needs gh to reach GitHub, but gh is not authenticated (run: gh auth login)$suffix"
}

# MERGED / OPEN / CLOSED, or NONE when the branch has no pull request. Safe to
# read a non-zero exit as "no PR" only because require_gh already established
# that gh itself works.
branch_pr_state() {
  gh pr view "$1" --json state --jq '.state' 2>/dev/null || printf 'NONE\n'
}

cmd_prune() {
  local apply=0

  while [[ $# -gt 0 ]]; do
    case $1 in
      --yes) apply=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*) die "unknown option: $1 (run 'cwt help')" ;;
      *) die 'prune takes no positional arguments' ;;
    esac
    shift
  done

  require_gh prune

  local line path='' branch='' physical state here i
  local -a ripe_branches=() ripe_paths=() skipped=()
  here=$(pwd -P)

  while IFS= read -r line; do
    case $line in
      'worktree '*)
        path=${line#worktree }
        branch=''
        ;;
      'branch refs/heads/'*)
        branch=${line#branch refs/heads/}
        ;;
      '')
        # The `!= "$primary"` term is deliberately redundant with the managed-root
        # check below — the primary checkout does not live under the managed root,
        # so containment already excludes it. Kept as defense in depth on the only
        # bulk-delete path in the tool. Do not remove it as dead code.
        if [[ -n $path && -n $branch && $path != "$primary" && ! -L $path ]]; then
          case $path in
            "$managed_root"/*)
              physical=$(cd -P "$path" 2>/dev/null && pwd -P) || physical=''
              # An intermediate component can be replaced by a symlink after Git
              # records the lexical worktree path. Re-check the resolved path
              # before placing it on prune's deletion list.
              case "$physical/" in
                "$managed_root"/*) ;;
                *) physical='' ;;
              esac
              if [[ -n $physical ]]; then
                if [[ $here == "$physical" || $here == "$physical"/* ]]; then
                  skipped+=("$branch — you are standing in it")
                elif worktree_is_dirty "$physical"; then
                  skipped+=("$branch — uncommitted or untracked work")
                else
                  state=$(branch_pr_state "$branch")
                  if [[ $state == MERGED ]]; then
                    ripe_branches+=("$branch")
                    ripe_paths+=("$physical")
                  else
                    skipped+=("$branch — pull request is $state")
                  fi
                fi
              fi
              ;;
          esac
        fi
        path=''
        ;;
    esac
  done < <(
    git worktree list --porcelain
    printf '\n'
  )

  if ((${#skipped[@]})); then
    note "left alone (${#skipped[@]}):"
    printf '  %s\n' "${skipped[@]}"
  fi

  if ((${#ripe_branches[@]} == 0)); then
    note 'nothing to prune'
    return 0
  fi

  if ((apply == 0)); then
    note "would remove ${#ripe_branches[@]} worktree(s) — re-run with --yes to apply:"
    for i in "${!ripe_branches[@]}"; do
      printf '  %s  %s\n' "${ripe_branches[i]}" "${ripe_paths[i]}"
    done
    return 0
  fi

  # Branches are kept: the worktree is disposable, the branch is history.
  for i in "${!ripe_branches[@]}"; do
    remove_worktree "${ripe_paths[i]}" "${ripe_branches[i]}" 0
  done
}

# Query canonical PR identity before doing anything. A fresh checkout then
# verifies both the local branch name and exact head object before it records
# reusable markers. Existing PR worktrees take a separate path: fetch detached
# into a disposable worktree, prove the real worktree is clean and belongs to
# this PR, then fast-forward or reset from its last verified head.
cmd_pr() {
  # `--force` and `--no-review` are pr-only — parse_launch_args must not learn
  # them, or branch/new/open/root silently start accepting them too. Stripped
  # here, before the remainder reaches the shared parser. Stops at the first
  # `--`: from there on every argument belongs to codex (the `--` contract the
  # shared parser itself implements), and scanning the whole argv would
  # misread `cwt pr 12 -- --force` as a request to reset the branch (or
  # `-- --no-review` as a request to skip the review prompt) instead of
  # forwarding the literal flag to codex.
  local -a rest=()
  local force=0 no_review=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --)
        rest+=("$@")
        break
        ;;
      --force)
        force=1
        ;;
      --no-review)
        no_review=1
        ;;
      *)
        rest+=("$1")
        ;;
    esac
    shift
  done

  # Two literal calls, not a guarded "${rest[@]}" expansion: under `set -u`,
  # expanding an empty array errors on bash older than 4.4 — the same hazard
  # the guarded-array precedent in launch() exists to avoid.
  if ((${#rest[@]})); then
    parse_launch_args "${rest[@]}"
  else
    parse_launch_args
  fi
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'pr requires exactly one pull request number'

  local number=${LAUNCH_POSITIONAL[0]} meta head_ref cross head_owner head_repo
  local pr_url head_oid name target
  case $number in
    '' | *[!0-9]*) die "pull request must be a number: $number" ;;
  esac

  require_gh pr

  meta=$(gh pr view "$number" \
    --json headRefName,isCrossRepository,headRepositoryOwner,headRepository,url,headRefOid \
    --jq '.headRefName, .isCrossRepository, .headRepositoryOwner.login, .headRepository.name, .url, .headRefOid' 2>/dev/null) ||
    die "cannot resolve pull request #$number"
  head_ref=$(printf '%s\n' "$meta" | sed -n 1p)
  cross=$(printf '%s\n' "$meta" | sed -n 2p)
  # Case-folded on both sides: GitHub reports the canonical spelling, while the
  # clone URL keeps whatever the developer typed. An unfolded compare would
  # silently withhold auto-force forever from anyone whose remote reads
  # `ItsACoyote/…`, and the plain path gives no hint why.
  head_owner=$(printf '%s\n' "$meta" | sed -n 3p | tr '[:upper:]' '[:lower:]')
  head_repo=$(printf '%s\n' "$meta" | sed -n 4p | tr '[:upper:]' '[:lower:]')
  pr_url=$(printf '%s\n' "$meta" | sed -n 5p)
  head_oid=$(printf '%s\n' "$meta" | sed -n 6p)
  [[ -n $head_ref ]] || die "pull request #$number has no head branch"
  # head_ref is fork-controlled input, unvalidated before this point — reject a
  # malicious ref name before it reaches branch_worktree or any other git command.
  validate_branch "$head_ref"
  # Anything other than a literal true/false would otherwise reach the
  # auto-force decision below unvalidated — fail closed by naming the only two
  # values that decision can trust.
  [[ $cross == true || $cross == false ]] ||
    die "cannot determine whether pull request #$number comes from a fork"
  pr_url_identity "$pr_url" "$number" ||
    die "pull request #$number returned an invalid canonical URL"
  valid_head_oid "$head_oid" ||
    die "pull request #$number returned an invalid head object ID"

  local existing
  if existing=$(branch_worktree "$head_ref"); then
    reuse_pr_or_refuse "$head_ref" "$existing" "$number" "$pr_url" "$head_oid" \
      "$head_ref" "$head_owner" "$head_repo" "$cross" "$no_review"
  fi

  # Captured UNCONDITIONALLY, outside the $cross gate below: only the
  # auto-force DECISION is gated on cross, but the die-hint after a failed
  # checkout further down needs this fact for a fork PR too. A three-term &&
  # that short-circuited on $cross would leave it unset there and silence the
  # hint on exactly the fork + coincidentally-same-named-local-branch failure
  # it exists to serve. (reuse_or_refuse above already owns the case where the
  # branch is checked out somewhere, so "exists" here means "exists, unheld".)
  local branch_existed=0
  if git show-ref --verify --quiet "refs/heads/$head_ref"; then
    branch_existed=1
  fi

  # Four required terms, all gating the DECISION only (branch_existed itself
  # stays ungated, see above): not cross-repository — a fork's head ref name
  # can coincide with an unrelated base-repo branch, so containment there
  # would prove nothing about the fork's actual head, and fork PRs always take
  # the plain path; origin is the repository the head actually lives in; a
  # pre-existing local branch to reset; and that branch provably contained in
  # the pre-fetch origin tip. `((! force))` short-circuits the whole probe for
  # an explicit --force, which already means reset and needs no safety check.
  #
  # The identity term is not implied by the cross-repository one. gh resolves
  # the pull request's repository on its own, with no regard for which remote a
  # clone happens to call origin. In a fork workflow — origin your fork,
  # upstream the base repo — a NON-cross-repository pull request still means
  # "head lives in upstream", and refs/remotes/origin/<branch> is then a
  # same-named branch in a different repository entirely. Containment against
  # it proves nothing about the pull request, and the reset would be judged
  # against unrelated commits.
  local auto_force=0
  if ((! force)) && [[ $cross == false ]] &&
    [[ $head_owner == "$(printf '%s' "$owner" | tr '[:upper:]' '[:lower:]')" ]] &&
    [[ $head_repo == "$(printf '%s' "$repo" | tr '[:upper:]' '[:lower:]')" ]] &&
    ((branch_existed)) && branch_contained_in_origin "$head_ref"; then
    auto_force=1
  fi

  name=$(worktree_name_for_branch "$head_ref")
  validate_worktree_name "$name"
  target="$managed_root/$name"
  ensure_available_path "$target"
  mkdir -p "$managed_root"

  # Detached, because `gh pr checkout` is what decides the branch — for a fork it
  # may pick a local name of its own.
  git worktree add --detach --quiet "$target" HEAD
  # Two literal invocations for the same "${rest[@]}"-under-set-u reason as the
  # arg-parsing pre-pass above — `gh pr checkout "$number" "${arr[@]}"` with an
  # empty $arr errors on bash older than 4.4.
  local checkout_ok=1
  if ((force || auto_force)); then
    if ((auto_force)); then
      note "resetting $head_ref — it has no local-only commits"
    fi
    (cd "$target" && gh pr checkout "$number" --force) || checkout_ok=0
  else
    (cd "$target" && gh pr checkout "$number") || checkout_ok=0
  fi
  if ((! checkout_ok)); then
    # Clean up rather than leaving a half-made worktree. This is not theoretical:
    # `cwt pr` against a merged pull request whose head branch has since been
    # deleted fails exactly here, and an orphaned worktree makes the retry fail
    # for a second, unrelated-looking reason.
    git worktree remove --force "$target" 2>/dev/null || true
    # Only worth the hint when a local branch was actually in the way — the
    # captured, pre-fetch fact, not a re-check now that gh has already run and
    # moved the tracking ref out from under a re-check. Also gated on !force
    # and !auto_force: a failed checkout that already ran WITH --force (explicit
    # or auto) means resetting the branch is exactly what just failed to help,
    # so re-suggesting the same --force would be circular.
    local hint=''
    if ((branch_existed && ! force && ! auto_force)); then
      hint=" — $head_ref may have diverged from the pull request; run 'cwt pr $number --force' to reset it"
    fi
    die "gh could not check out pull request #$number$hint"
  fi

  local checked_out_branch checked_out_head
  checked_out_branch=$(git -C "$target" symbolic-ref --quiet --short HEAD 2>/dev/null) || {
    abandon_worktree "$target"
    die "gh did not check pull request #$number out on its head branch"
  }
  if [[ $checked_out_branch != "$head_ref" ]]; then
    abandon_worktree "$target"
    die "gh checked pull request #$number out as $checked_out_branch instead of $head_ref"
  fi
  checked_out_head=$(git -C "$target" rev-parse HEAD 2>/dev/null) || {
    abandon_worktree "$target"
    die "cannot verify the checked-out head for pull request #$number"
  }
  if [[ $checked_out_head != "$head_oid" ]]; then
    abandon_worktree "$target"
    die "pull request #$number changed while it was being checked out; run cwt pr $number again"
  fi

  copy_worktree_includes "$target" || {
    abandon_worktree "$target"
    die "could not prepare the worktree for pull request #$number"
  }

  record_pr_markers "$head_ref" "$pr_url" "$head_oid" || {
    abandon_worktree "$target"
    die "could not record the verified identity for pull request #$number"
  }

  # A context-fetch failure here keeps the worktree rather than abandoning
  # it: markers are already recorded, so a retry takes the reuse path above
  # instead of re-running the whole checkout.
  local ctx_ok=1
  write_pr_context "$number" "$pr_url" "$head_oid" "$name" "$head_ref" "$cross" || ctx_ok=0
  finish_pr_context "$no_review" "$number" "$ctx_ok" "$target" "$PR_CONTEXT_BASE_REF" "$head_oid"

  if [[ $cross == true ]]; then
    printf '%s: WARNING: pull request #%s comes from a fork — this is code you did not write, and opening it here runs it on your machine\n' \
      "$PROGRAM" "$number" >&2
  fi

  launch "$target"
}

cmd_remove() {
  local branch='' delete_branch=0

  while [[ $# -gt 0 ]]; do
    case $1 in
      --delete-branch) delete_branch=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*) die "unknown option: $1 (run 'cwt help')" ;;
      *)
        [[ -z $branch ]] || die 'remove takes exactly one branch name'
        branch=$1
        ;;
    esac
    shift
  done
  [[ -n $branch ]] || die 'remove requires a branch name'

  resolve_removable "$branch"
  if worktree_is_dirty "$resolved_worktree"; then
    die "worktree has uncommitted or untracked work, refusing to remove: $resolved_worktree"
  fi
  remove_worktree "$resolved_worktree" "$branch" "$delete_branch"
}

cmd_branch() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'branch requires exactly one branch name'

  local branch=${LAUNCH_POSITIONAL[0]} existing name target
  validate_branch "$branch"

  if existing=$(branch_worktree "$branch"); then
    reuse_or_refuse "$branch" "$existing"
  fi

  name=$(worktree_name_for_branch "$branch")
  validate_worktree_name "$name"
  target="$managed_root/$name"
  ensure_available_path "$target"
  mkdir -p "$managed_root"

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$target" "$branch"
  else
    note "fetching origin/$branch"
    remote_git fetch --quiet origin "refs/heads/$branch:refs/remotes/origin/$branch" ||
      die "could not fetch origin/$branch: not on origin, or origin unreachable"
    git worktree add -b "$branch" "$target" "origin/$branch"
  fi

  copy_worktree_includes "$target" || {
    abandon_worktree "$target"
    die "could not prepare the worktree for $branch"
  }
  launch "$target"
}

cmd_new() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'new requires exactly one branch name'

  local branch=${LAUNCH_POSITIONAL[0]} existing base name target
  validate_branch "$branch"
  [[ $branch == */* ]] ||
    die "new needs a typed branch name such as feat/account-recovery or fix/login-timeout"

  if existing=$(branch_worktree "$branch"); then
    reuse_or_refuse "$branch" "$existing"
  fi

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    die "local branch already exists but is not checked out: $branch (use 'cwt branch $branch')"
  fi

  name=$(worktree_name_for_branch "$branch")
  validate_worktree_name "$name"
  target="$managed_root/$name"
  ensure_available_path "$target"

  note "resolving origin's default branch"
  base=$(default_remote_branch)
  note "fetching origin/$base"
  remote_git fetch --quiet origin "refs/heads/$base:refs/remotes/origin/$base"

  mkdir -p "$managed_root"
  git worktree add -b "$branch" "$target" "origin/$base"
  copy_worktree_includes "$target" || {
    abandon_worktree "$target"
    die "could not prepare the worktree for $branch"
  }
  launch "$target"
}

cmd_open() {
  parse_launch_args "$@"
  ((${#LAUNCH_POSITIONAL[@]} == 1)) || die 'open requires exactly one branch name'

  local branch=${LAUNCH_POSITIONAL[0]} target
  validate_branch "$branch"
  target=$(branch_worktree "$branch") ||
    die "no worktree checked out for branch: $branch"
  require_managed_worktree "$target"
  launch "$target"
}

# Lists this repository's worktrees, marking any that live outside the managed
# root. Other worktree tooling does not consult cwt, so showing those worktrees
# as unmanaged is more honest than hiding entries the developer can plainly see
# in `git worktree list`.
cmd_list() {
  [[ $# -eq 0 ]] || die 'list takes no arguments'

  local line path='' branch='' width=0
  local -a listed_branches=() listed_paths=() listed_marks=()

  while IFS= read -r line; do
    case $line in
      'worktree '*)
        path=${line#worktree }
        branch='(detached)'
        ;;
      'branch refs/heads/'*)
        branch=${line#branch refs/heads/}
        ;;
      '')
        # Blank line terminates a record. The primary checkout is a worktree as
        # far as git is concerned, but it is not one cwt manages.
        if [[ -n $path && $path != "$primary" ]]; then
          listed_branches+=("$branch")
          listed_paths+=("$path")
          case $path in
            "$managed_root"/*) listed_marks+=('') ;;
            *) listed_marks+=('(unmanaged)') ;;
          esac
          if ((${#branch} > width)); then width=${#branch}; fi
        fi
        path=''
        ;;
    esac
  done < <(
    git worktree list --porcelain
    printf '\n'
  )

  if ((${#listed_branches[@]} == 0)); then
    printf 'No managed worktrees for %s/%s.\n' "$owner" "$repo"
    return 0
  fi

  local i
  for i in "${!listed_branches[@]}"; do
    if [[ -n ${listed_marks[i]} ]]; then
      printf '%-*s  %s  %s\n' "$width" "${listed_branches[i]}" "${listed_paths[i]}" "${listed_marks[i]}"
    else
      printf '%-*s  %s\n' "$width" "${listed_branches[i]}" "${listed_paths[i]}"
    fi
  done
}

# Resolves this script's real path, following symlinks by hand. `readlink -f` would
# do it in one call but is GNU-only, and this library is copied onto machines we do
# not control. Matters because `cwt install` is normally run *through* the symlink
# it installed — without this it would happily point the symlink at itself.
resolve_self() {
  local src=$0 dir
  case $src in
    */*) ;;
    *) src=$(command -v -- "$src" 2>/dev/null) || src=$0 ;;
  esac
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd -P)
    src=$(readlink "$src")
    case $src in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  dir=$(cd -P "$(dirname "$src")" && pwd -P)
  printf '%s/%s\n' "$dir" "$(basename "$src")"
}

path_contains() {
  case ":${PATH-}:" in
    *":$1:"*) return 0 ;;
  esac
  return 1
}

# Symlinks — deliberately, not copies. A symlink tracks every later edit to the
# repo script, so the tool stays current as the library is updated, and there is
# never a stale duplicate to wonder about.
# Points <target> at <source>, creating the parent directory, repointing a
# symlink that aims elsewhere, and refusing to clobber anything that is not a
# symlink — a real file there belongs to someone else.
link_into_place() {
  local source=$1 target=$2 current

  mkdir -p "${target%/*}" || die "cannot create ${target%/*}"

  if [[ -L $target ]]; then
    current=$(readlink "$target")
    if [[ $current == "$source" ]]; then
      note "already installed: $target -> $source"
      return 0
    fi
    ln -sfn "$source" "$target" || die "cannot update symlink: $target"
    note "repointed $target -> $source"
    return 0
  fi

  [[ ! -e $target ]] ||
    die "$target exists and is not a symlink; move it aside and retry"

  ln -s "$source" "$target" || die "cannot create symlink: $target"
  note "installed $target -> $source"
}

cmd_install() {
  [[ $# -eq 0 ]] || die 'install takes no arguments'

  local bin_dir="$HOME/.local/bin"
  local source completion_source completion_dir
  source=$(resolve_self)
  completion_source="${source%/*}/cwt-completion.bash"

  link_into_place "$source" "$bin_dir/cwt"

  # bash-completion 2.x autoloads a file named after the command from here, so
  # Tab works in a new shell with no rc edit. A symlink rather than a copy, for
  # the same reason as the binary: it tracks later edits.
  completion_dir="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
  if [[ -f $completion_source ]]; then
    link_into_place "$completion_source" "$completion_dir/cwt"
  else
    note "no completion script beside cwt, skipping: $completion_source"
  fi

  install_path_warning "$bin_dir"
}

install_path_warning() {
  path_contains "$1" && return 0
  printf '%s: warning: %s is not on your PATH; add it to use `cwt` directly\n' \
    "$PROGRAM" "$1" >&2
}

# Undocumented diagnostic seam: prints the resolved foundation values so the test
# suite (and a confused human) can see what cwt thinks it is working with.
cmd_debug_roots() {
  printf 'owner=%s\n' "$owner"
  printf 'repo=%s\n' "$repo"
  printf 'primary=%s\n' "$primary"
  printf 'managed_root=%s\n' "$managed_root"
}

main() {
  local command=${1:-list}
  case $command in
    -h | --help | help)
      usage
      ;;
    debug-roots)
      require_repo
      cmd_debug_roots
      ;;
    list)
      shift || true
      require_repo
      cmd_list "$@"
      ;;
    install)
      shift || true
      cmd_install "$@" # deliberately no require_repo; install is repo-independent
      ;;
    root | open | new | branch | remove | prune | pr)
      shift || true
      require_repo
      "cmd_$command" "$@"
      ;;
    *)
      die "unknown command: $command (run 'cwt help')"
      ;;
  esac
}

main "$@"
